@model Improvar.Models.Login
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@Module.Module_Name</title>
    @Styles.Render("~/Content/css")
    <script src="~/Scripts/jquery-3.3.1.js"></script>
    <script src="~/Scripts/bootstrap.js"></script>
    <script src="~/Scripts/Custom.js"></script>
    @Scripts.Render("~/bundles/modernizr")
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico">
    <link rel="stylesheet" href="~/Content/login_signup.css?Ver=@Module.ContentVersion" />
    <head runat="server">
        <title></title>
    </head>

    @*<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyBrcfaBjHKJWpTeEkQbdwom5ExTn7zbt2c&callback"  defer></script>*@

    @*<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyBrcfaBjHKJWpTeEkQbdwom5ExTn7zbt2c&callback"
    async defer></script>*@

    @*<script src="http://maps.google.com/maps/api/js?sensor=false"></script>*@
    @*<script type="text/javascript">
            $(document).ready(function () {
                debugger;
                if (navigator.geolocation) {
                    navigator.geolocation.getCurrentPosition(showPosition);
                } else {
                    showCustomAlert('info',"Geolocation is not supported by this browser.");
                }
                function showPosition(position) {
                    $("#latitude").val(position.coords.latitude);
                    $("#longitude").val(position.coords.longitude);
                    //$("#latitudeshow").val(position.coords.latitude);
                    //$("#longitudeshow").val(position.coords.longitude);
                }
            });
        </script>*@
    <script type="text/javascript">
        $(document).ready(function () {
            getLocation(function (loc) {
                if (loc) {
                    $("#latitude").val(loc.lat);
                    $("#longitude").val(loc.lng);
                    //showCustomAlert("info", "Location: " + loc.lat + ", " + loc.lng);
                }
                else {
                    return false;
                    //showCustomAlert("info", "Location: ");
                }
            });


            // On form submission, ensure location is present
            //$("form").submit(function (e) {
            //    if ($("#locationReady").val() !== "true") {
            //        showCustomAlert('info',"Location is required before Login.");
            //        e.preventDefault();
            //        return false;
            //    }
            //});
        });
    </script>
    <script>
        function ShowHide() {
            var x1 = document.getElementById("Password");
            var x2 = document.getElementById("eye");
            var x3 = document.getElementById("eye_close");
            if (x1.type === "password") {
                x1.type = "text";
                x2.style.display = "none";
                x3.style.display = "block";
                return false;
                //window.onload = ShowHide();
            }
            else {
                x1.type = "password";
                x2.style.display = "block";
                x3.style.display = "none";
                return false;
                //window.onload = ShowHide();
            }
            //window.onload = ShowHide();
        }
    </script> 
    <script>       
        function Login() {
            debugger;           
            getLocation(function (loc) {
                if (loc) {
                    $("#WaitingMode").show();
                    $("#latitude").val(loc.lat);
                    $("#longitude").val(loc.lng);
                    //jQuery("form").attr("target", "_blank");
                    //jQuery("form").submit();
                    document.forms[0].submit();
                }
                else {
                    return false;
                }
            });
        }
    </script>
</head>

<body class="bodyclass">
    <div id="WaitingMode" style="display:none; margin: 0px; padding: 0px; position: fixed; right: 0px; top: 0px; width: 100%; height: 100%; background-color: rgb(16, 134, 16); z-index: 30001; opacity: 0.4;">
        <p style="position: absolute; color: White; top: 46%; left: 47%;">
            Loading, please wait...<br />
            <span> <img src="~/Image/ajax_loader.gif" width="60px" height="60px"></span>
        </p>
    </div>
    @using (Html.BeginForm())
    {
        <div class="modal-content">
            <div class="row">
                <div class="col-lg-6">
                    <center>
                        <img src="~/Image/IPSMART-LOGO.png" height="100px" width="100px" />
                        <h3>
                            @Module.Module_Name
                        </h3>
                        <h6>
                            <span class="glyphicon glyphicon-log-in"></span>
                            Welcome to IP-SMART
                        </h6>
                    </center>
                </div>
                <div class="col-lg-6">
                    <label><b>User ID</b></label>
                    @Html.EditorFor(model => model.UserName, new { htmlAttributes = new { id = "UserName", @class = "ttext TEXT", placeholder = "Enter User ID", required = "required", autofocus = "autofocus", autocomplete = "off", onkeyup = "toUpper(UserName)" } })
                    <label><b>Password</b></label>
                    @Html.PasswordFor(model => model.Password, new { value = Model.Password, @class = "passview1 blocks1", placeholder = "Enter Password", id = "Password", required = "required" })
                    <img src="~/Image/pass_eye_close.png" name="pa2" id="eye" style="cursor:pointer" class="passview2 blocks1" onclick="ShowHide();">
                    <img src="~/Image/pass_eye.png" style="display:none;cursor:pointer " name="pa3" id="eye_close" class="passview2 blocks1" onclick="ShowHide();">
                    @Html.HiddenFor(model => model.IP)
                    @Html.HiddenFor(model => model.latitude, new { id = "latitude" })
                    @Html.HiddenFor(model => model.longitude, new { id = "longitude" })
                    @Html.HiddenFor(model => model.AndroidId, new { id = "AndroidId" })
  <input type="hidden" id="locationReady" value="false" />
                    <br />
                    <br />
                    <br />
                    <br />
                    <div class="row">
                        <div class="col-lg-7">
                            <span>@Html.CheckBoxFor(model => model.REMEMBERME) </span>
                            Remember me
                        </div>
                        <div class="col-lg-5 text-right">
                            @Html.ActionLink("Change password", "ChangePassword", null, new { onclick = "this.href += '?USERID=' + document.getElementById('UserName').value;" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-7">
                            <button type="button" id="btnLogin" class="btn btn-lg btn-info" onclick="Login();">Login</button>
                            @*<input type="button" onclick="requestLocationFromApp()" class="btn btn-sm btn-success" value="Testing" />*@
                        </div>
                        <div class="col-lg-5 text-right">
                            @Html.ActionLink("Forgot Password ?", "ForgotPassword", null, new { onclick = "this.href += '?USERID=' + document.getElementById('UserName').value;" })
                        </div>
                    </div>
                    @*<div class="row">
                        <div class="col-lg-4">
                            @Html.EditorFor(model => model.latitude, new { htmlAttributes = new { id = "latitudeshow", @class = "ttext TEXT" } })
                        </div>
                        <div class="col-lg-4">
                            @Html.EditorFor(model => model.longitude, new { htmlAttributes = new { id = "longitudeshow", @class = "ttext TEXT" } })
                        </div>
                    </div>*@
                    <center>
                        <p>
                            @if (@ViewBag.Flag == "1")
                            {
                                <span style="color:red"> @ViewBag.Msg @Html.ActionLink("Click Here", "ChangePassword", new { cpf = "1" })</span>
                            }
                            else
                            {
                                <span style="color:red">
                                    @ViewBag.Msg
                                </span>
                            }
                        </p>
                    </center>
                </div>
            </div>
        </div>
    }
    <div id="customAlert" style="display:none;
     position:fixed; top:0; left:0; width:100%; height:100%;
     background:rgba(0,0,0,0.4); z-index:40000;
     justify-content:center; align-items:center;">
        <div id="customAlertBox" style="background:#fff; padding:20px 30px;
       border-radius:10px; box-shadow:0 0 10px rgba(0,0,0,0.3);
       text-align:center; min-width:260px; max-width:80%;max-height:70vh; overflow-y:auto;">
            <div id="customAlertIcon" style="font-size:40px; margin-bottom:10px;"></div>
            <p id="customAlertMessage" style="font-size:16px; margin-bottom:15px;"></p>
            <button onclick="closeCustomAlert()" id="customAlertButton"
                    style="background:#007bff; color:white; border:none;
                   padding:8px 20px; border-radius:5px; cursor:pointer;">
                OK
            </button>
        </div>
    </div>
</body>
</html>