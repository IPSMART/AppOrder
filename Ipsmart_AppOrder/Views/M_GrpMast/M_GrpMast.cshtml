                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="editor-field">
                        @Html.DropDownListFor(model => model.Dstbrslcd, new SelectList(Model.ListDistributor, "Value", "Text", Model.Dstbrslcd), "Select", new { @class = "form-control select2", id = "Dstbrslcd", @onchange = "BindRetailer();" })
                        @Html.HiddenFor(model => model.Dstbrslnm, new { id = "Dstbrslnm" })
                        @Html.HiddenFor(model => model.SLMSLCD, new { id = "SLMSLCD" })


                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-5">
                    <div class="editor-field" style="margin-top: 4px;">
                        @Html.Label("", "Retailer Name")
                        <b style="color:Red;">*</b>
                        <a onclick="RetailMaster();" style="pointer-events:none;color:#428bca8c" id="BtnAddRtl">
                            <span class="glyphicon glyphicon-plus-sign" style="font-size:20px;margin-top:3px;"></span>
                        </a>
                        @*<a href="../M_RetailOutlet/M_RetailOutlet?op=A&MNUDET=UFJPRE1BU1R+MH5NX0dycE1hc3R+fk1+MH4wfkFFRFY=&US=@US&DC=&MP=" target="_blank" style="pointer-events:none;color:#428bca8c" id="BtnAddRtl">
                            <span class="glyphicon glyphicon-plus-sign" style="font-size:20px;margin-top:3px;"></span>
                        </a>*@
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="editor-field" style="margin-top: 4px;">
                        @Html.DropDownListFor(model => model.RetailerCode, new SelectList(Model.ListRetailer, "Value", "Text", Model.RetailerCode), "Select", new { @class = "form-control select2", id = "RetailerCode" })
                        @Html.HiddenFor(model => model.RetailerName, new { id = "RetailerName" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-5">
                    <div class="editor-field" style="margin-top: 4px;">
                        @Html.Label("", "Brand")
                        <b style="color:Red;">*</b>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="editor-field" style="margin-top: 4px;">
                        @Html.DropDownListFor(model => model.BrandCode, new SelectList(Model.ListBrand, "Value", "Text", Model.BrandCode), new { @class = "form-control select2", id = "BrandCode", multiple = "multiple", @onchange = "BindGroup();" })
