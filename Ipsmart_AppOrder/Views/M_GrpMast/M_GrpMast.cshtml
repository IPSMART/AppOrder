@model Improvar.ViewModels.VMRetailOrder
@{
    Layout = "~/Views/Shared/_LayoutReport.cshtml";
    string PageControllerName = "M_GrpMast";
    string US = Model?.UNQSNO_ENCRYPTED;

}
<script>
    window.addEventListener("unload", function () { });
    debugger;
    // If this page loads and reloadOnBack flag is set, refresh
    if (sessionStorage.getItem("reloadOnBack") === "true") {
        sessionStorage.removeItem("reloadOnBack");
        location.reload();
    }
</script>
<script type="text/javascript">
    $(document).ready(function () {
        //getLocation();

        function formatResult(item) {
            if (!item.id) return item.text;
            var parts = item.text.split(String.fromCharCode(181));
            return $('<div><strong>' + parts[0] + '</strong><br/><small>' + parts[1] + '</small></div>');
        }

        function formatSelection(item) {
            return item.text.split(String.fromCharCode(181))[0];
        }

        $('#Dstbrslcd').select2({
            width: '100%',
            placeholder: "Select Distributor",
            allowClear: true,
            templateResult: formatResult,
            templateSelection: formatSelection,
        });

        $('#Dstbrslcd').change(function () {
            debugger;
            var selectedText = $("#Dstbrslcd option:selected").text();
            $('#Dstbrslnm').val(selectedText);
        });

        $('#RetailerCode').select2({
            width: '100%',
            placeholder: "Select Retailer",
            allowClear: true,
            templateResult: formatResult,
            templateSelection: formatSelection,
        });

        $('#RetailerCode').change(function () {
            debugger;
            var selectedText = $("#RetailerCode option:selected").text();
            $('#RetailerName').val(selectedText);
        });

        $('#BrandCode').select2({
            width: '100%',
            placeholder: "Select Brand",
            allowClear: true,
            closeOnSelect: false,
        });

        $('#BrandCode').change(function () {
            debugger;
            var selectedTexts = $('#BrandCode option:selected').map(function () {
                return $(this).text();
            }).get().join(', '); // You can change delimiter if needed

            $('#BrandName').val(selectedTexts);

        });

        $('#GroupCode').select2({
            width: '100%',
            placeholder: "Select Group",
            allowClear: true,
            closeOnSelect: false,
        });

        $('#GroupCode').change(function () {
            debugger;
            var selectedTexts = $('#GroupCode option:selected').map(function () {
                return $(this).text();
            }).get().join(', '); // You can change delimiter if needed

            $('#GroupName').val(selectedTexts);

        });

        $('#CollCode').select2({
            width: '100%',
            placeholder: "Select Collection",
            allowClear: true,
            closeOnSelect: false,
        });

        $('#CollCode').change(function () {
            debugger;
            var selectedTexts = $('#CollCode option:selected').map(function () {
                return $(this).text();
            }).get().join(', '); // You can change delimiter if needed

            $('#CollName').val(selectedTexts);

        });
    });
</script>
<script>
    function getLocation() {
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                function (position) {
                    // Success: Set hidden fields
                    $("#GEOLONGITUDE").val(position.coords.latitude);
                    $("#GEOLATITUDE").val(position.coords.longitude);
                    console.log(position.coords.latitude + ',' + position.coords.longitude);

                },
                function (error) {
                    alert("Location access is required to use this service.");

                }
            );
        } else {
            alert("Geolocation is not supported by this browser.");

        }
    }
    function BindRetailer() {
        debugger;

        var Dstbrslcd = $("#Dstbrslcd").val();
        if (Dstbrslcd) {
            $('#BtnAddRtl').css('pointer-events', 'auto');
            $('#BtnAddRtl').css('color', '#428bca');
        }
        else {
            $('#BtnAddRtl').css('pointer-events', 'none');
            $('#BtnAddRtl').css('color', 'rgba(66, 139, 202, 0.55)');
        }
        $('#RetailerCode').empty().append('<option value="">Select Retailer</option>');
        $.ajax({
            url: "@Url.Action("BindRetailerData", PageControllerName)",
            type: 'POST',
        beforesend: $("#WaitingMode").show(),
        data: { Distributor: Dstbrslcd },
        success: function (result) {
            $.each(result, function (index, ListRetailer) {
                $('#RetailerCode').append('<option value="' + ListRetailer.value + '">' + ListRetailer.text + '</option>');
            });
            $('#RetailerCode').trigger('change'); // Refresh Select2
            $("#WaitingMode").hide();
        },
        error: function (XMLHttpRequest, textStatus, errorThrown) {
            $("#WaitingMode").hide();
            msgError(XMLHttpRequest.responseText);
            $("body span h1").remove(); $("#msgbody_error style").remove();
        }
    });
    }
    function BindGroup() {
        debugger;
        $('#GroupCode').empty().append('<option value="">Select Group</option>');
            $.ajax({
                url: "@Url.Action("BindGroupData", PageControllerName)",
                type: 'POST',
                beforesend: $("#WaitingMode").show(),
                data: $('form').serialize(),
                success: function (result) {
                    $.each(result, function (index, ListGroup) {
                        $('#GroupCode').append('<option value="' + ListGroup.value + '">' + ListGroup.text + '</option>');
                    });
                    $('#GroupCode').trigger('change.select2'); // Refresh Select2
                    $("#WaitingMode").hide();
                },
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                    $("#WaitingMode").hide();
                    msgError(XMLHttpRequest.responseText);
                    $("body span h1").remove(); $("#msgbody_error style").remove();
                }
            });
    }
</script>
<script>
    function GetItemData() {
        debugger;
        if (!emptyFieldCheck("Please Select Distributor Name", "Dstbrslcd")) { return false; }
        if (!emptyFieldCheck("Please Select Retailer Name", "RetailerCode")) { return false; }
        if (!emptyFieldCheck("Please Select Brand", "BrandCode")) { return false; }
        $.ajax({
            type: 'post',
            beforesend: $("#WaitingMode").show(),
            url: "@Url.Action("GetItem", PageControllerName)",
            data: $('form').serialize() + "&DOCNO=" + $("#DOCNO").val() + "&DOC_CD=" + $("#DOC_ID").val(),
            success: function (result) {
                sessionStorage.setItem("reloadOnBack", "true");
                window.location.href = '@Url.Action("T_RetailerOrder", "T_RetailerOrder", new { US = Model.UNQSNO_ENCRYPTED })';

                @*//testing
            window.open("@Url.Action("T_RetailerOrder", "T_RetailerOrder", new { US = Model.UNQSNO_ENCRYPTED })", "_blank")
            *@
                $("#WaitingMode").hide();
            },
            error: function (XMLHttpRequest, textStatus, errorThrown) {
                $("#WaitingMode").hide();
                msgError(XMLHttpRequest.responseText);
                $("body span h1").remove(); $("#msgbody_error style").remove();
            }
        });
    }
    function RetailMaster() {
        debugger;
        if (!emptyFieldCheck("Please Select Distributor Name", "Dstbrslcd")) { return false; }
        $.ajax({
            type: 'post',
            beforesend: $("#WaitingMode").show(),
            url: "@Url.Action("OpenRetailMaster", PageControllerName)",
            data: $('form').serialize() ,
        success: function (result) {
            sessionStorage.setItem("reloadOnBack", "true");
            let op = "A";
            let mnudet = encodeURIComponent("UFJPRE1BU1R+MH5NX0dycE1hc3R+fk1+MH4wfkFFRFY=");
            let us = '@Model.UNQSNO_ENCRYPTED';
            let dc = "";
            let mp = "";
            window.location.href = '@Url.Action("M_RetailOutlet", "M_RetailOutlet")'
    + `?op=${op}&MNUDET=${mnudet}&US=${us}&DC=${dc}&MP=${mp}`;

            @*//testing
       let url = '@Url.Action("M_RetailOutlet", "M_RetailOutlet")'
    + `?op=${op}&MNUDET=${mnudet}&US=${us}&DC=${dc}&MP=${mp}`;
window.open(url, '_blank');*@
        $("#WaitingMode").hide();

        },
        error: function (XMLHttpRequest, textStatus, errorThrown) {
            $("#WaitingMode").hide();
            msgError(XMLHttpRequest.responseText);
            $("body span h1").remove(); $("#msgbody_error style").remove();
        }
    });
    }
</script>
@using (Html.BeginForm())
{
    if (Model.DefaultView == true)
    {
        @Html.HiddenFor(a => Model.maxdate)
        @Html.HiddenFor(a => Model.mindate)
        <div class="form-horizontal" style="padding-left:5px;padding-right:5px;">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <input type="hidden" id="btnSave" value="@Url.Action("SAVE", PageControllerName)" />
            <input type="hidden" id="MetalCode" value="@Url.Action("CheckCode", PageControllerName)" />
            <input type="hidden" id="srhpnl" value="@Url.Action("SearchPannelData", PageControllerName)" />
            <input type="hidden" id="add_doc_url" value="@Url.Action("AddDOCRow", PageControllerName )" />
            <input type="hidden" id="del_doc_url" value="@Url.Action("DeleteDOCRow", PageControllerName )" />
            @Html.HiddenFor(model => model.GEOLONGITUDE)
            @Html.HiddenFor(model => model.GEOLATITUDE)
            @*@Html.HiddenFor(model => model.GEOADDRESS)*@
            @Html.HiddenFor(model => model.ITEMDETAIL_JSTR)
            <div class="row" id="divGetRetailerInfo">
                <div class="col-md-5">
                    <div class="editor-field" style="margin-top: 4px;">
                        @Html.Label("", "Distributor Name")
