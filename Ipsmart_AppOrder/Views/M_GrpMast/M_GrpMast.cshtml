@model Improvar.ViewModels.VMRetailOrder
@{
    Layout = "~/Views/Shared/_LayoutAppOrder.cshtml";
    string PageControllerName = "M_GrpMast";
    string US = Model?.UNQSNO_ENCRYPTED;

}
<script type="text/javascript">
    $(document).ready(function () {
        //getLocation();

        function formatResult(item) {
            if (!item.id) return item.text;
            var parts = item.text.split(String.fromCharCode(181));
            return $('<div><strong>' + parts[0] + '</strong><br/><small>' + parts[1] + '</small></div>');
        }

        function formatSelection(item) {
            return item.text.split(String.fromCharCode(181))[0];
        }

        $('#Dstbrslcd').select2({
            width: '100%',
            placeholder: "Select Distributor",
            allowClear: true,
            templateResult: formatResult,
            templateSelection: formatSelection,
        });


        $('#RetailerCode').select2({
            width: '100%',
            placeholder: "Select Retailer",
            allowClear: true,
            templateResult: formatResult,
            templateSelection: formatSelection,
        });
        $('#BrandCode').select2({
            width: '100%',
            placeholder: "Select Brand",
            allowClear: true,
            closeOnSelect: false,
        });

        $('#GroupCode').select2({
            width: '100%',
            placeholder: "Select Group",
            allowClear: true,
            closeOnSelect: false,
        });

        $('#CollCode').select2({
            width: '100%',
            placeholder: "Select Collection",
            allowClear: true,
            closeOnSelect: false,
        });


        $('#Dstbrslcd').change(function () {
            debugger;
            var selectedText = $("#Dstbrslcd option:selected").text();
            $('#Dstbrslnm').val(selectedText);
        });

        $('#RetailerCode').change(function () {
            debugger;
            var selectedText = $("#RetailerCode option:selected").text();
            $('#RetailerName').val(selectedText);
        });

        $('#BrandCode').change(function () {
            debugger;
            var selectedTexts = $('#BrandCode option:selected').map(function () {
                return $(this).text();
            }).get().join(', '); // You can change delimiter if needed

            $('#BrandName').val(selectedTexts);

        });

        $('#GroupCode').change(function () {
            debugger;
            var selectedTexts = $('#GroupCode option:selected').map(function () {
                return $(this).text();
            }).get().join(', '); // You can change delimiter if needed

            $('#GroupName').val(selectedTexts);

        });

        $('#CollCode').change(function () {
            debugger;
            var selectedTexts = $('#CollCode option:selected').map(function () {
                return $(this).text();
            }).get().join(', '); // You can change delimiter if needed

            $('#CollName').val(selectedTexts);

        });
    });
</script>
<script>
    function getLocation() {
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                function (position) {
                    // Success: Set hidden fields
                    $("#GEOLONGITUDE").val(position.coords.latitude);
                    $("#GEOLATITUDE").val(position.coords.longitude);
                    console.log(position.coords.latitude + ',' + position.coords.longitude);

                },
                function (error) {
                    alert("Location access is required to use this service.");

                }
            );
        } else {
            alert("Geolocation is not supported by this browser.");

        }
    }
    function BindRetailer() {
        debugger;

        var Dstbrslcd = $("#Dstbrslcd").val();
        $('#RetailerCode').empty().append('<option value="">Select Retailer</option>');

        if (Dstbrslcd) {
            $.ajax({
                url: "@Url.Action("BindRetailerData", PageControllerName)",
                type: 'POST',
                beforesend: $("#WaitingMode").show(),
                data: { Distributor: Dstbrslcd },
                success: function (result) {
                    $.each(result, function (index, ListRetailer) {
                        $('#RetailerCode').append('<option value="' + ListRetailer.value + '">' + ListRetailer.text + '</option>');
                    });
                    $('#RetailerCode').trigger('change'); // Refresh Select2
                    $("#WaitingMode").hide();
                },
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                    $("#WaitingMode").hide();
                    msgError(XMLHttpRequest.responseText);
                    $("body span h1").remove(); $("#msgbody_error style").remove();
                }
            });
        }
    }
</script>
<script>
    function GetItemData() {
        debugger;
        let values = $('#BrandCode').val();
        if (!emptyFieldCheck("Please Select Distributor Name", "Dstbrslcd")) { return false; }
        if (!emptyFieldCheck("Please Select Retailer Name", "RetailerCode")) { return false; }
        if (!emptyFieldCheck("Please Select Brand", "BrandCode")) { return false; }
        $.ajax({
            type: 'post',
            beforesend: $("#WaitingMode").show(),
            url: "@Url.Action("GetItem", PageControllerName)",
            data: $('form').serialize() + "&DOCNO=" + $("#DOCNO").val() + "&DOC_CD=" + $("#DOC_ID").val(),
            success: function (result) {
                window.location.href = "@Url.Action("T_RetailerOrder", "T_RetailerOrder", new { US = Model.UNQSNO_ENCRYPTED })";
                if (newWindow) {
                    window.open('', '_self'); // Required for some browsers
                    window.close(); // Attempt to close current window
                } else {
                    alert("Popup blocked! Please allow popups for this website.");
                }
            }
        });
    }
</script>
