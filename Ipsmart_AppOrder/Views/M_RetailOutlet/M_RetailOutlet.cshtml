<link href="~/Content/select2.min.css" rel="stylesheet" />
<script src="~/Scripts/select2.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {

        function formatResult(item) {
            if (!item.id) return item.text;
            var parts = item.text.split(String.fromCharCode(181));
            return $('<div><strong>' + parts[0] + '</strong><br/><small>' + parts[1] + '</small></div>');
        }
        function formatSelection(item) {
            return item.text.split(String.fromCharCode(181))[0];
        }
        $('#STATECD').select2({
            width: '100%',
            placeholder: "Select State",
            allowClear: true,
            templateResult: formatResult,
            templateSelection: formatSelection,
        });

        $('#CNCD').select2({
            width: '100%',
            placeholder: "Select Country",
            allowClear: true,
            templateResult: formatResult,
            templateSelection: formatSelection,
        });
        @*var preselected = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Dstbrslcd));

        $('#Dstbrslcd').select2({
            width: '100%',
            placeholder: "Select Distributor",
            allowClear: true,
            closeOnSelect: false,
        });
        $('#Dstbrslcd').val(preselected).trigger('change');*@

        if ("@Model.DefaultAction" == "V" || "@Model.DefaultAction" == "D") {
            modeView();
            $('.select2-selection').css('pointer-events', 'none');
            $('.select2-selection').css('background-color', '#eeeeee');
        }
        else if ("@Model.DefaultAction" == "E") {
            $("#PURECD").attr("readonly", true);
        }
        else if ("@Model.DefaultAction" == "A") {
            getLocation(function (latlot) {
                $("#WaitingMode").show();
                if (latlot != "") {
                    var LAT = returncolvalue(latlot, "LAT");
                    var LOT = returncolvalue(latlot, "LOT");

                    $("#GPSLAT").val(LAT);
                    $("#GPSLOT").val(LOT);

                    $.ajax({
                        type: 'POST',
                        beforesend: $("#WaitingMode").show(),
                        url: "@Url.Action("GetRetailAddress", PageControllerName)",
                        data: { lat: LAT, lot: LOT },
                        success: function (result) {
                            $("#GPSNM").val(result);
                        },
                        error: function (XMLHttpRequest) {
                            $("#WaitingMode").hide();
                            msgError(XMLHttpRequest.responseText);
                        }
                    });
                }
                $('form :input:enabled:visible:not([readonly]):first').focus();
                $("#WaitingMode").hide();
            });
        }
        $("#WaitingMode").hide();
    });
</script>
