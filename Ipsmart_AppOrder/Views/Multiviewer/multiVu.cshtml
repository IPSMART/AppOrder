@{
    ViewBag.Title = "";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CRM Garment</title>
    @*@Styles.Render("~/Content/all.min.css?Ver=" + Module.ContentVersion)*@

    @*<link href="~/Content/all.min.css" rel="stylesheet" />*@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            overflow-x: hidden;
        }

        /* Header */
        header {
            background: #d9edf7;
            border-color: #bce8f1;
            color: #3a87ad;
            padding: 15px;
            font-size: 18px;
            /*display: flex;*/
            align-items: center;
            position: relative;
            z-index: 1001;
        }

            header .menu-btn {
                font-size: 24px;
                cursor: pointer;
                margin-right: 15px;
            }

        /* Sidebar */
        .sidebar {
            position: fixed;
            top: 0;
            left: -260px;
            width: 260px;
            height: 100%;
            background: #d9edf7;
            border-color: #bce8f1;
            color: #3a87ad;
            transition: 0.3s;
            padding-top: 20px;
            z-index: 1000;
            overflow-y: auto;
        }

            .sidebar.active {
                left: 0;
            }

        /* Close button */
        .close-btn {
            position: absolute;
            top: 10px;
            right: 20px;
            font-size: 22px;
            color: #fff;
            cursor: pointer;
        }

        /* Search bar container */
        .search-container {
            display: flex;
            align-items: center;
            margin: 50px 20px 15px 20px;
            background: #fff;
            border-radius: 4px;
            overflow: hidden;
        }

            .search-container input {
                flex: 1;
                padding: 8px 10px;
                border: none;
                outline: none;
                color: #000;
            }

            .search-container button {
                background: #d9edf7;
                color: #fff;
                border: none;
                padding: 8px 12px;
                cursor: pointer;
            }

        /* Menu */
        .sidebar ul {
            list-style: none;
            margin-top: 10px;
        }

            .sidebar ul li {
                padding: 10px 20px;
                cursor: pointer;
                position: relative;
            }

                .sidebar ul li:hover {
                    background: #fff6;
                }

                .sidebar ul li i {
                    float: right;
                    margin-top: 4px;
                }

        /* Submenu */
        .submenu {
            display: none;
            background: #d9edf7;
        }

            .submenu li {
                padding: 8px 40px;
                font-size: 14px;
            }

        /* Content */
        .content {
            padding: 20px;
            transition: 0.3s;
            margin-left: 0;
        }

            .content.shifted {
                margin-left: 260px;
            }

        @@media (max-width: 768px) {
            .content.shifted {
                margin-left: 0;
            }
        }
    </style>
    <style>
        .navmenu a {
            text-align: center;
            float: left;
            width: 20px;
            height: 20px;
            border-radius: 100%;
            margin-right: 7px; /*space between*/
            display: flex;
            align-items: flex-start;
            transition: all 0.4s;
            -webkit-transition: all 0.4s;
            text-decoration: none;
        }

            .navmenu a i {
                font-size: 15px;
                align-self: center;
                transition: all 0.4s;
                -webkit-transition: all 0.4s;
                margin: 0 auto;
            }
    </style>
</head>
<body>

    <header>
        <i class="fas fa-bars menu-btn"></i> CRM Garment
        <div class="navmenu" style="float:right;">
            <a href="../Home/Logout" style="border: 2px solid #dc0624f2;"><i class="fa fa-power-off fa-lg" style="color:#dc0624f2;"></i></a>
        </div>
    </header>

    <div class="sidebar" id="sidebar">
        <i class="fas fa-times close-btn" id="closeBtn"></i>

        <!-- Search box -->
        <div class="search-container">
            <input type="text" id="search" placeholder="Search menu...">
        </div>

        <!-- Menu Items -->
        <ul id="menu">
            <li onclick="window.open('@Url.Action("T_RetailerOrderFilter","T_RetailerOrderFilter")','_self')" class="menu-item">Retail Order</li>
            <li onclick="window.open('@Url.Action("Rep_RetailerOrder","Rep_RetailerOrder")','_self')" class="menu-item">Retail Order Register</li>
            <li onclick="window.open('@Url.Action("T_DistOrderFilter","T_DistOrderFilter")','_self')" class="menu-item">Distributor Order</li>
            <li onclick="window.open('@Url.Action("Rep_DistOrder","Rep_DistOrder")','_self')" class="menu-item">Distributor Order Register</li>
  @*<li class="menu-item has-submenu">
                    Products <i class="fas fa-chevron-down"></i>
                    <ul class="submenu">
                        <li>Electronics</li>
                        <li>Clothing</li>
                        <li>Accessories</li>
                    </ul>
                </li>
                <li class="menu-item has-submenu">
                    Services <i class="fas fa-chevron-down"></i>
                    <ul class="submenu">
                        <li>Consulting</li>
                        <li>Support</li>
                        <li>Training</li>
                    </ul>
                </li>
                <li class="menu-item">About</li>
                <li class="menu-item">Contact</li>*@
        </ul>
    </div>

    <div class="content" id="content">
        <h1>Welcome</h1>
        @*<p>This is your main page content.</p>*@
    </div>

    <script>
        const menuBtn = document.querySelector('.menu-btn');
        const sidebar = document.getElementById('sidebar');
        const content = document.getElementById('content');
        const closeBtn = document.getElementById('closeBtn');
        const submenus = document.querySelectorAll('.has-submenu');
        const menuItems = document.querySelectorAll('#menu > li');
        const searchInput = document.getElementById('search');
        //const searchBtn = document.getElementById('searchBtn');

        // Toggle sidebar open
        menuBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            sidebar.classList.add('active');
            content.classList.add('shifted');
        });

        // Close sidebar with close button
        closeBtn.addEventListener('click', () => {
            sidebar.classList.remove('active');
            content.classList.remove('shifted');
        });

        // Close sidebar when clicking outside
        document.addEventListener('click', (e) => {
            if (sidebar.classList.contains('active') && !sidebar.contains(e.target) && !menuBtn.contains(e.target)) {
                sidebar.classList.remove('active');
                content.classList.remove('shifted');
            }
        });

        // Toggle submenus
        submenus.forEach(item => {
            item.addEventListener('click', (e) => {
                e.stopPropagation(); // prevent sidebar from closing
                const submenu = item.querySelector('.submenu');
                submenu.style.display = submenu.style.display === 'block' ? 'none' : 'block';
            });
        });

        // Close sidebar when clicking a normal menu item
        menuItems.forEach(item => {
            item.addEventListener('click', () => {
                if (!item.classList.contains('has-submenu')) {
                    sidebar.classList.remove('active');
                    content.classList.remove('shifted');
                }
            });
        });

        // Search button functionality
        function filterMenu() {
            const filter = searchInput.value.toLowerCase();
            const items = document.querySelectorAll('#menu > li');
            items.forEach(item => {
                const text = item.textContent.toLowerCase();
                item.style.display = text.includes(filter) ? 'block' : 'none';
            });
        }
        searchInput.addEventListener('keyup', filterMenu);
        //searchBtn.addEventListener('click', filterMenu);
    </script>

</body>
</html>
