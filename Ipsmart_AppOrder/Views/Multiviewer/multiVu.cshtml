@model Improvar.Models.Menu
@{
    ViewBag.Title = "";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>CRM Garment</title>
    @*@Styles.Render("~/Content/all.min.css?Ver=" + Module.ContentVersion)*@

    @*<link href="~/Content/all.min.css" rel="stylesheet" />*@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/Content/bootstrap.css" />

    <script src="~/Scripts/jquery-3.3.1.min.js" type="text/javascript"></script>

    @Scripts.Render("~/Scripts/Custom.js?Ver=" + Session["publishversion"])


    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        html, body {
            height: 100%;
        }

        body {
            overflow-x: hidden;
            position: relative;
            height: 100%;
        }

        /* Header */
        header {
            background: #d9edf7;
            border-color: #bce8f1;
            color: #3a87ad;
            padding: 15px;
            font-size: 18px;
            position: fixed; /* ADD */
            top: 0; /* ADD */
            left: 0; /* ADD */
            width: 100%; /* ADD */
            z-index: 3000; /* HIGHER THAN SIDEBAR */
        }

            header .menu-btn {
                font-size: 24px;
                cursor: pointer;
                margin-right: 15px;
            }

        /* Sidebar */
        .sidebar {
            position: absolute; /* CHANGE from fixed */
            top: 60px;
            left: -260px;
            width: 260px;
            bottom: 0;
            background: #d9edf7;
            color: #3a87ad;
            transition: left 0.3s ease;
            z-index: 2000;
            overflow-y: auto;
        }

            .sidebar.active {
                left: 0;
            }


        /* Close button */
        .close-btn {
            position: absolute;
            top: 10px;
            right: 20px;
            font-size: 22px;
            color: #fff;
            cursor: pointer;
        }

        /* Search bar container */
        .search-container {
            display: flex;
            align-items: center;
            margin: 15px 20px 15px 20px;
            background: #fff;
            border-radius: 4px;
            overflow: hidden;
        }

            .search-container input {
                flex: 1;
                padding: 8px 10px;
                border: none;
                outline: none;
                color: #000;
            }

            .search-container button {
                background: #d9edf7;
                color: #fff;
                border: none;
                padding: 8px 12px;
                cursor: pointer;
            }

        /* Menu */
        .sidebar ul {
            list-style: none;
            margin-top: 10px;
            position: relative;
            z-index: 2;
        }

            .sidebar ul li {
                padding: 10px 20px;
                cursor: pointer;
                position: relative;
                display: block;
            }

                .sidebar ul li:hover {
                    background: #fff6;
                }

                .sidebar ul li i {
                    float: right;
                    margin-top: 4px;
                }

        .sidebar li {
            position: relative;
            z-index: 2;
            background: #d9edf7;
        }

        /* Submenu */
        .submenu {
            display: none;
            background: #d9edf7;
        }

            .submenu li {
                padding: 8px 40px;
                font-size: 14px;
            }

        /* Content */
        .content {
            padding: 80px 20px 20px 20px;
            min-height: 100vh;
            background: #fff;
        }

            .content.shifted {
                margin-left: 260px;
            }

        @@media (max-width: 768px) {
            .content.shifted {
                margin-left: 0;
            }
        }
    </style>
    <style>
        .navmenu a {
            text-align: center;
            float: left;
            width: 20px;
            height: 20px;
            border-radius: 100%;
            margin-right: 7px; /*space between*/
            display: flex;
            align-items: flex-start;
            transition: all 0.4s;
            -webkit-transition: all 0.4s;
            text-decoration: none;
        }

            .navmenu a i {
                font-size: 15px;
                align-self: center;
                transition: all 0.4s;
                -webkit-transition: all 0.4s;
                margin: 0 auto;
            }
    </style>
    <script>
        function SaveAttendance() {
            $("#WaitingMode").show();
            getLocation(function (loc) {
                if (loc) {
                    var LAT = loc.lat;
                    var LOT = loc.lng;

                    $("#GPSLAT").val(LAT);
                    $("#GPSLOT").val(LOT);
                }
                else {
                    $("#WaitingMode").hide();
                    return false;
                }
                if (!emptyFieldCheck("Location not found,Save again", "GPSLOT")) {
                    $("#WaitingMode").hide();
                    return false;
                }
                if (!emptyFieldCheck("Location not found,Save again", "GPSLAT")) {
                    $("#WaitingMode").hide();
                    return false;
                }
                var GPSLAT = $("#GPSLAT").val();
                var GPSLOT = $("#GPSLOT").val();
                $.ajax({
                    type: 'post',
                    beforesend: $("#WaitingMode").show(),
                    url: "@Url.Action("SaveAttendanceData", "Multiviewer")",
                    data: $('form').serialize() + "&GPSLAT=" + GPSLAT + "&GPSLOT=" + GPSLOT,
                    success: function (result) {
                        showCustomAlert('info', result);
                        $("#WaitingMode").hide();
                    },
                    error: function (XMLHttpRequest, textStatus, errorThrown) {
                        $("#WaitingMode").hide();
                        msgError(XMLHttpRequest.responseText);
                        $("body span h1").remove(); $("#msgbody_error style").remove();
                    }
                });
            });

        }
    </script>
    <script type="text/javascript">

    function sendUserDataToAndroid() {

        var userId = '@(CommVar.UserID() ?? "")';
        var moduleCode = '@(Module.Module_Code ?? "")';
        var sessionNo = '@(CommVar.SessionNo() ?? "")';
        var compCode = '';
        var locCode = '';

        if (window.AndroidApp && AndroidApp.saveUserData) {

            AndroidApp.saveUserData(
                userId.toString(),
                moduleCode.toString(),
                sessionNo.toString(),
                compCode.toString(),
                locCode.toString()
            );

        } else {
            console.log("Android interface not available");
        }
    }

    function onDataSaved(status) {

        console.log("Android Response: " + status);

        if (status === "SUCCESS") {
            console.log("Data saved successfully");
        } else {
            console.log("Error saving data");
        }
    }

    // 🔥 WebView-safe page load
    document.addEventListener("DOMContentLoaded", function () {
        setTimeout(function () {
            sendUserDataToAndroid();
        }, 500);
    });

    </script>

</head>
<body>
    <div id="WaitingMode" style="display:none; margin: 0px; padding: 0px; position: fixed; right: 0px; top: 0px; width: 100%; height: 100%; background-color: rgb(16, 134, 16); z-index: 30001; opacity: 0.4;">
        <p style="position: absolute; color: White; top: 46%; left: 47%;">
            Loading, please wait...<br />
            <span> <img src="~/Image/ajax_loader.gif" width="60px" height="60px"></span>
        </p>
    </div>
    <header>
        <i class="fas fa-bars menu-btn"></i> CRM Garment
        <div class="navmenu" style="float:right;">
            <a href="../Home/Logout" style="border: 2px solid #dc0624f2;"><i class="fa fa-power-off fa-lg" style="color:#dc0624f2;"></i></a>
        </div>
    </header>

    <div class="sidebar" id="sidebar">
        @*<i class="fas fa-times close-btn" id="closeBtn"></i>*@

        <!-- Search box -->
        <div class="search-container">
            <input type="text" id="search" placeholder="Search menu...">
        </div>

        <!-- Menu Items -->
        <ul id="menu">
            <li onclick="window.open('@Url.Action("T_RetailerOrderFilter","T_RetailerOrderFilter")','_self')" class="menu-item">Retail Order</li>
            <li onclick="window.open('@Url.Action("Rep_RetailerOrder","Rep_RetailerOrder")','_self')" class="menu-item">Retail Order Register</li>
            <li onclick="window.open('@Url.Action("Rep_RetailOutlet","Rep_RetailOutlet")','_self')" class="menu-item">Retailer's Counter Report</li>
            <li onclick="window.open('@Url.Action("T_DistOrderFilter","T_DistOrderFilter")','_self')" class="menu-item">Distributor Order</li>
            <li onclick="window.open('@Url.Action("Rep_DistOrder","Rep_DistOrder")','_self')" class="menu-item">Distributor Order Register</li>
            <li onclick="window.open('@Url.Action("T_SLM_DLYREP","T_SLM_DLYREP")','_self')" class="menu-item">Salesmen Daily Acitivity</li>
            <li onclick="window.open('@Url.Action("Rep_SLM_DLYREP","Rep_SLM_DLYREP")','_self')" class="menu-item">Salesmen Daily Acitivity Report</li>
            @*<li class="menu-item has-submenu">
                    Products <i class="fas fa-chevron-down"></i>
                    <ul class="submenu">
                        <li>Electronics</li>
                        <li>Clothing</li>
                        <li>Accessories</li>
                    </ul>
                </li>
                <li class="menu-item has-submenu">
                    Services <i class="fas fa-chevron-down"></i>
                    <ul class="submenu">
                        <li>Consulting</li>
                        <li>Support</li>
                        <li>Training</li>
                    </ul>
                </li>
                <li class="menu-item">About</li>
                <li class="menu-item">Contact</li>*@
        </ul>
    </div>

    <div class="content" id="content">
        <h1>Welcome</h1>
        @*<p>This is your main page content.</p>*@
        <div class="row">
            <div class="col-md-6" style="width:auto;margin-top: 4px;">
                <div class="editor-field">
                    @*<input type="button" class="btn btn-info" style="padding:2px 2px 2px 2px;" value="Attendance" onclick="SaveAttendance()" />*@
                    @Html.HiddenFor(model => model.GPSLOT, new { id = "GPSLOT" })
                    @Html.HiddenFor(model => model.GPSLAT, new { id = "GPSLAT" })
                </div>
            </div>
        </div>
    </div>
    <div id="customAlert" style="display:none;
     position:fixed; top:0; left:0; width:100%; height:100%;
     background:rgba(0,0,0,0.4); z-index:40000;
     justify-content:center; align-items:center;">
        <div id="customAlertBox" style="background:#fff; padding:20px 30px;
       border-radius:10px; box-shadow:0 0 10px rgba(0,0,0,0.3);
       text-align:center; min-width:260px; max-width:80%;max-height:70vh; overflow-y:auto;">
            <div id="customAlertIcon" style="font-size:40px; margin-bottom:10px;"></div>
            <p id="customAlertMessage" style="font-size:16px; margin-bottom:15px;"></p>
            <button onclick="closeCustomAlert()" id="customAlertButton"
                    style="background:#007bff; color:white; border:none;
                   padding:8px 20px; border-radius:5px; cursor:pointer;">
                OK
            </button>
        </div>
    </div>
    <script>
        const menuBtn = document.querySelector('.menu-btn');
        const sidebar = document.getElementById('sidebar');
        const content = document.getElementById('content');
        const submenus = document.querySelectorAll('.has-submenu');
        const menuItems = document.querySelectorAll('#menu > li');
        const searchInput = document.getElementById('search');
        //const searchBtn = document.getElementById('searchBtn');

        let startX = 0;
        let endX = 0;

        // Toggle sidebar open
        menuBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            sidebar.classList.toggle('active');
        });

        // Close sidebar with close button
        //closeBtn.addEventListener('click', () => {
        //    sidebar.classList.remove('active');
        //    content.classList.remove('shifted');
        //});

        // Close sidebar when clicking outside
        document.addEventListener('click', (e) => {
            if (sidebar.classList.contains('active') && !sidebar.contains(e.target) && !menuBtn.contains(e.target)) {
                sidebar.classList.remove('active');
            }
        });

        // Toggle submenus
        submenus.forEach(item => {
            item.addEventListener('click', (e) => {
                e.stopPropagation(); // prevent sidebar from closing
                const submenu = item.querySelector('.submenu');
                submenu.style.display = submenu.style.display === 'block' ? 'none' : 'block';
            });
        });

        // Close sidebar when clicking a normal menu item
        menuItems.forEach(item => {
            item.addEventListener('click', () => {
                if (!item.classList.contains('has-submenu')) {
                    sidebar.classList.remove('active');
                }
            });
        });

        /* SWIPE LEFT → CLOSE */
        sidebar.addEventListener('touchstart', function (e) {
            startX = e.touches[0].clientX;
        });

        sidebar.addEventListener('touchmove', function (e) {
            endX = e.touches[0].clientX;
        });

        sidebar.addEventListener('touchend', function () {
            if (startX - endX > 60) {   // swipe left distance
                sidebar.classList.remove('active');
            }
        });

        // Search button functionality
        function filterMenu() {
            const filter = searchInput.value.toLowerCase();
            const items = document.querySelectorAll('#menu > li');
            items.forEach(item => {
                const text = item.textContent.toLowerCase();
                item.style.display = text.includes(filter) ? 'block' : 'none';
            });
        }
        searchInput.addEventListener('keyup', filterMenu);
        //searchBtn.addEventListener('click', filterMenu);
    </script>

</body>
</html>
