@model Improvar.ViewModels.ReportViewinHtml
@{
    Layout = "~/Views/Shared/_LayoutReport.cshtml";
    string PageControllerName = "Rep_DistOrder";
    string US = Model?.UNQSNO_ENCRYPTED;

}
<script type="text/javascript">
    $(document).ready(function () {

        function formatResult(item) {
            if (!item.id) return item.text;
            var parts = item.text.split(String.fromCharCode(181));
            return $('<div><strong>' + parts[0] + '</strong><br/><small>' + parts[1] + '</small></div>');
        }

        function formatSelection(item) {
            return item.text.split(String.fromCharCode(181))[0];
        }

        $('#Dstbrslcd').select2({
            width: '100%',
            placeholder: "Select Distributor",
            allowClear: true,
            closeOnSelect: false,
            templateResult: formatResult,
            templateSelection: formatSelection,

        });

        $('#Dstbrslcd').change(function () {
            var selectedTexts = $('#Dstbrslcd option:selected').map(function () {
                return $(this).text();
            }).get().join(', '); // You can change delimiter if needed
            $('#Dstbrslnm').val(selectedTexts);
        });

        $('#RetailerCode').select2({
            width: '100%',
            placeholder: "Select Retailer",
            allowClear: true,
            closeOnSelect: false,
            templateResult: formatResult,
            templateSelection: formatSelection,
        });

        $('#RetailerCode').change(function () {
            var selectedTexts = $('#RetailerCode option:selected').map(function () {
                return $(this).text();
            }).get().join(', '); // You can change delimiter if needed
            $('#RetailerName').val(selectedTexts);
        });

        $('#BrandCode').select2({
            width: '100%',
            placeholder: "Select Brand",
            allowClear: true,
            closeOnSelect: false,
        });

        $('#BrandCode').change(function () {

            var selectedTexts = $('#BrandCode option:selected').map(function () {
                return $(this).text();
            }).get().join(', '); // You can change delimiter if needed

            $('#BrandName').val(selectedTexts);

        });

        $('#GroupCode').select2({
            width: '100%',
            placeholder: "Select Group",
            allowClear: true,
            closeOnSelect: false,
        });

        $('#GroupCode').change(function () {

            var selectedTexts = $('#GroupCode option:selected').map(function () {
                return $(this).text();
            }).get().join(', '); // You can change delimiter if needed

            $('#GroupName').val(selectedTexts);

        });

        $('#CollCode').select2({
            width: '100%',
            placeholder: "Select Collection",
            allowClear: true,
            closeOnSelect: false,
        });

        $('#CollCode').change(function () {

            var selectedTexts = $('#CollCode option:selected').map(function () {
                return $(this).text();
            }).get().join(', '); // You can change delimiter if needed

            $('#CollName').val(selectedTexts);

        });
    });
    window.onload = function () {
        document.getElementById("WaitingMode").style.display = "none";
    };
</script>
<script>
    function BindRetailer() {
        var Dstbrslcd = $("#Dstbrslcd").val();

        $('#RetailerCode').empty().append('<option value="">Select Retailer</option>');
        $.ajax({
            url: "@Url.Action("BindRetailerData", PageControllerName)",
            type: 'POST',
        beforesend: $("#WaitingMode").show(),
        data: { Distributor: Dstbrslcd },
        success: function (result) {
            $.each(result, function (index, ListRetailer) {
                $('#RetailerCode').append('<option value="' + ListRetailer.value + '">' + ListRetailer.text + '</option>');
            });
            $('#RetailerCode').trigger('change'); // Refresh Select2
            $("#WaitingMode").hide();
        },
        error: function (XMLHttpRequest, textStatus, errorThrown) {
            $("#WaitingMode").hide();
            msgError(XMLHttpRequest.responseText);
            $("body span h1").remove(); $("#msgbody_error style").remove();
        }
    });
    }
    function BindGroup() {

        $('#GroupCode').empty().append('<option value="">Select Group</option>');
        $.ajax({
            url: "@Url.Action("BindGroupData", PageControllerName)",
            type: 'POST',
        beforesend: $("#WaitingMode").show(),
        data: $('form').serialize(),
        success: function (result) {
            $.each(result, function (index, ListGroup) {
                $('#GroupCode').append('<option value="' + ListGroup.value + '">' + ListGroup.text + '</option>');
            });
            $('#GroupCode').trigger('change.select2'); // Refresh Select2
            $("#WaitingMode").hide();
        },
        error: function (XMLHttpRequest, textStatus, errorThrown) {
            $("#WaitingMode").hide();
            msgError(XMLHttpRequest.responseText);
            $("body span h1").remove(); $("#msgbody_error style").remove();
        }
    });
    }
    function BindCollection() {
        
        $('#CollCode').empty().append('<option value="">Select Collection</option>');
        $.ajax({
            url: "@Url.Action("BindCollectionData", PageControllerName)",
            type: 'POST',
        beforesend: $("#WaitingMode").show(),
        data: $('form').serialize(),
        success: function (result) {
            $.each(result, function (index, ListCollection) {
                $('#CollCode').append('<option value="' + ListCollection.value + '">' + ListCollection.text + '</option>');
            });
            $('#CollCode').trigger('change.select2'); // Refresh Select2
            $("#WaitingMode").hide();
        },
        error: function (XMLHttpRequest, textStatus, errorThrown) {
            $("#WaitingMode").hide();
            msgError(XMLHttpRequest.responseText);
            $("body span h1").remove(); $("#msgbody_error style").remove();
        }
    });
    }
</script>

@using (Html.BeginForm())
{
    if (Model.DefaultView == true)
    {
        @Html.HiddenFor(a => Model.maxdate)
        @Html.HiddenFor(a => Model.mindate)
        <div class="form-horizontal" style="padding-left:5px;padding-right:5px;">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <input type="hidden" id="btnSave" value="@Url.Action("SAVE", PageControllerName)" />
            <input type="hidden" id="MetalCode" value="@Url.Action("CheckCode", PageControllerName)" />
            <input type="hidden" id="srhpnl" value="@Url.Action("SearchPannelData", PageControllerName)" />
            <input type="hidden" id="add_doc_url" value="@Url.Action("AddDOCRow", PageControllerName )" />
            <input type="hidden" id="del_doc_url" value="@Url.Action("DeleteDOCRow", PageControllerName )" />
            @Html.HiddenFor(model => model.GEOLONGITUDE)
            @Html.HiddenFor(model => model.GEOLATITUDE)
            @*@Html.HiddenFor(model => model.GEOADDRESS)*@
            <div class="row">
                <div class="col-lg-2">
                    <div class="editor-field" style="margin-top: 4px;">
                        @Html.Label("", "Distributor Name")
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="editor-field">
                        @Html.DropDownListFor(model => model.Dstbrslcd, new SelectList(Model.ListDistributor, "Value", "Text", Model.Dstbrslcd), new { @class = "form-control select2", id = "Dstbrslcd", multiple = "multiple", @onchange = "BindRetailer();" })
                        @Html.HiddenFor(model => model.Dstbrslnm, new { id = "Dstbrslnm" })
                        @Html.HiddenFor(model => model.SLMSLCD, new { id = "SLMSLCD" })


                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-2">
                    <div class="editor-field" style="margin-top: 4px;">
                        @Html.Label("", "Retailer Name")
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="editor-field" style="margin-top: 4px;">
                        @Html.DropDownListFor(model => model.RetailerCode, new SelectList(Model.ListRetailer, "Value", "Text", Model.RetailerCode), new { @class = "form-control select2", id = "RetailerCode", multiple = "multiple" })
                        @Html.HiddenFor(model => model.RetailerName, new { id = "RetailerName" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-2">
                    <div class="editor-field" style="margin-top: 4px;">
                        @Html.Label("", "Brand")
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="editor-field" style="margin-top: 4px;">
                        @Html.DropDownListFor(model => model.BrandCode, new SelectList(Model.ListBrand, "Value", "Text", Model.BrandCode), new { @class = "form-control select2", id = "BrandCode", multiple = "multiple", @onchange = "BindCollection();" })
                        @Html.HiddenFor(model => model.BrandName, new { id = "BrandName" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-2">
                    <div class="editor-field" style="margin-top: 4px;">
                        @Html.Label("", "Collection")
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="editor-field" style="margin-top: 4px;">
                        @Html.DropDownListFor(model => model.CollCode, new SelectList(Model.ListCollection, "Value", "Text", Model.CollCode), new { @class = "form-control select2", id = "CollCode", multiple = "multiple", @onchange = "BindGroup();" })
                        @Html.HiddenFor(model => model.CollName, new { id = "CollName" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-2">
                    <div class="editor-field" style="margin-top: 4px;">
                        @Html.Label("", "Group")
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="editor-field" style="margin-top: 4px;">
                        @Html.DropDownListFor(model => model.GroupCode, new SelectList(Model.ListGroup, "Value", "Text", Model.GroupCode), new { @class = "form-control select2", id = "GroupCode", multiple = "multiple" })
                        @Html.HiddenFor(model => model.GroupName, new { id = "GroupName" })
                    </div>
                </div>
            </div>
            
            <div class="row">
                <div class="col-lg-5" style="width:auto;">
                    <div class="editor-label" style="margin-top: 0px;">
                        <input type="submit" formtarget="_blank" name="Show_rep" value="Show Report" title="Show report in a new tab" class="btn btn-sm btn-info" />
                    </div>
                </div>
            </div>


        </div>
    }
    else
    {
        @ViewBag.ErrorMessage
    }

    <div class="container">
        <div id="helpDIV">

        </div>
    </div>
}


