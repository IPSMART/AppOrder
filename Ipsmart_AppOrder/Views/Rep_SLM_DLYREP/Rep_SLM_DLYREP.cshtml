@model Improvar.ViewModels.ReportViewinHtml
@{
    ViewBag.Title = "Salesman Activity Report";
    Layout = "~/Views/Shared/_LayoutReport.cshtml";
    string PageControllerName = "Rep_SLM_DLYREP";
}
@*<script src="~/Scripts/jquery.min.js" type="text/javascript"></script>*@
<script type="text/javascript">
    $(document).ready(function () {

        function formatResult(item) {
            if (!item.id) return item.text;
            var parts = item.text.split(String.fromCharCode(181));
            return $('<div><strong>' + parts[0] + '</strong><br/><small>' + parts[1] + '</small></div>');
        }

        function formatSelection(item) {
            return item.text.split(String.fromCharCode(181))[0];
        }

        $('#Slsmnnm').select2({
            width: '100%',
            placeholder: "Select Salesman",
            allowClear: true,
            closeOnSelect: false,
            templateResult: formatResult,
            templateSelection: formatSelection,

        });

        $('#Dstbrslcd').change(function () {
            var selectedTexts = $('#Dstbrslcd option:selected').map(function () {
                return $(this).text();
            }).get().join(', '); // You can change delimiter if needed
            $('#Dstbrslnm').val(selectedTexts);
        });

        $('#RetailerCode').select2({
            width: '100%',
            placeholder: "Select Retailer",
            allowClear: true,
            closeOnSelect: false,
            templateResult: formatResult,
            templateSelection: formatSelection,
        });

        $('#RetailerCode').change(function () {
            var selectedTexts = $('#RetailerCode option:selected').map(function () {
                return $(this).text();
            }).get().join(', '); // You can change delimiter if needed
            $('#RetailerName').val(selectedTexts);
        });

        $('#BrandCode').select2({
            width: '100%',
            placeholder: "Select Brand",
            allowClear: true,
            closeOnSelect: false,
        });

        $('#BrandCode').change(function () {

            var selectedTexts = $('#BrandCode option:selected').map(function () {
                return $(this).text();
            }).get().join(', '); // You can change delimiter if needed

            $('#BrandName').val(selectedTexts);

        });

        $('#GroupCode').select2({
            width: '100%',
            placeholder: "Select Group",
            allowClear: true,
            closeOnSelect: false,
        });

        $('#GroupCode').change(function () {

            var selectedTexts = $('#GroupCode option:selected').map(function () {
                return $(this).text();
            }).get().join(', '); // You can change delimiter if needed

            $('#GroupName').val(selectedTexts);

        });

        $('#CollCode').select2({
            width: '100%',
            placeholder: "Select Collection",
            allowClear: true,
            closeOnSelect: false,
        });

        $('#CollCode').change(function () {

            var selectedTexts = $('#CollCode option:selected').map(function () {
                return $(this).text();
            }).get().join(', '); // You can change delimiter if needed

            $('#CollName').val(selectedTexts);

        });
    });
    window.onload = function () {
        document.getElementById("WaitingMode").style.display = "none";
    };
</script>
<link rel="stylesheet" href="~/Content/bootstrap-select.css" />
@Scripts.Render("~/Scripts/Multiple-Select-min.js")
@Scripts.Render("~/Scripts/bootstrap-select.js")
<script src="~/Scripts/jquery.min.js"></script>
<script>
    $(function () {
        $("#FDT").datepicker({ dateFormat: "dd/mm/yy", changeMonth: true, changeYear: true, maxDate: '@Model.maxdate' });
        $("#TDT").datepicker({ dateFormat: "dd/mm/yy", changeMonth: true, changeYear: true, maxDate: '@Model.maxdate' });
    });
</script>

@using (Html.BeginForm())
{
    @Html.HiddenFor(a => Model.maxdate)
    @Html.HiddenFor(a => Model.mindate)
    @Html.HiddenFor(model => model.Dstbrslnm, new { id = "Dstbrslnm" })
    @Html.HiddenFor(model => model.SLMSLCD, new { id = "SLMSLCD" })
    <div class="form-horizontal">
        @Html.HiddenFor(s => s.DefaultAction)
        <div class="row" style="margin-top: 8px;">
            <div class="col-md-6">
                <div class="editor-label" style="margin-top: 6px;">
                    @Html.Label("", "From Date")
                    <b style="color:Red;">
                        <sup>*</sup>
                    </b>
                </div>
            </div>
            <div class="col-md-6">
                <div class="editor-field">
                    @Html.EditorFor(model => model.FDT, new { htmlAttributes = new { @class = "form-control", id = "FDT", onblur = "DocumentDateCHK(this);", @placeholder = "dd/mm/yyyy", maxlength = 10 } })
                </div>
            </div>
        </div>
        <div class="row" style="margin-top: 8px;">
            <div class="col-md-6">
                <div class="editor-label" style="margin-top: 6px;">
                    @Html.Label("", "To Date")
                    <b style="color:Red;">
                        <sup>*</sup>
                    </b>
                </div>
            </div>
            <div class="col-md-6">
                <div class="editor-field">
                    @Html.EditorFor(model => model.TDT, new { htmlAttributes = new { @class = "form-control", id = "TDT", onblur = "DocumentDateCHK(this);", @placeholder = "dd/mm/yyyy", maxlength = 10 } })
                </div>
            </div>
        </div>        

        @*<div class="row" id="show_dtl">
            <div class="col-md-6">
