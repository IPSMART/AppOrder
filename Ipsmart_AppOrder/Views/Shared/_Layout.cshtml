                    <a href="../Home/Logout" style="border: 2px solid #dc0624f2;"><i class="fa fa-power-off fa-lg" style="color:#dc0624f2;"></i></a>
                </div>
            </div>
            <div class="container_box_inner">
                @RenderBody()
            </div>
        </div>
    </div>
    @if (Model.Add != "N")
    {
        <div class="bottomDiv">
            <div class="bottom-button-row">
                <button type="button" class="bottombutton btn btn-success" onclick="return pageValidation('A');">
                    <i class="fa fa-save"></i> Save
                </button>
                <a onclick="Reload();" style="border: 2px solid #3a87ad;width:25px;"><i class="fa fa-refresh" style="color:#f0ad4e;font-size:25px;"></i></a>

            </div>
        </div>
    }
    <div id="Msgdiv1" style="display:none">
        <div id="back_cover">
            @Html.Partial("_MessageBox")
        </div>
    </div>
    <div id="customAlert" style="display:none;
     position:fixed; top:0; left:0; width:100%; height:100%;
     background:rgba(0,0,0,0.4); z-index:40000;
     justify-content:center; align-items:center;">
        <div id="customAlertBox" style="background:#fff; padding:20px 30px;
       border-radius:10px; box-shadow:0 0 10px rgba(0,0,0,0.3);
       text-align:center; min-width:260px; max-width:80%;max-height:70vh; overflow-y:auto;">
            <div id="customAlertIcon" style="font-size:40px; margin-bottom:10px;"></div>
            <p id="customAlertMessage" style="font-size:16px; margin-bottom:15px;"></p>
            <button onclick="closeCustomAlert()" id="customAlertButton"
                    style="background:#007bff; color:white; border:none;
                   padding:8px 20px; border-radius:5px; cursor:pointer;">
                OK
            </button>
        </div>
    </div>

    <script>
        function HideConfirmOk() {
            $('#Msgdiv1').hide();
            $('#confirm').hide();
            deletePageData();
            return false;
        }
        function HideConfirmCancel() {
            $('#Msgdiv1').hide();
            $('#confirm').hide();
            return false;
        }
        function delete1() {
            function ok() {
                console.log('deleted');
                HideConfirmOk();
            }
            function cancel() {
                console.log('delete cancelled');
                HideConfirmCancel();
            }
            ConfirmInDiv('Are you sure to delete?', ok, cancel);
        }
    </script>
