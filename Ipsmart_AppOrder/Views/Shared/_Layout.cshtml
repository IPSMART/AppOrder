                <div class="navmenu" style="gap: 12px; flex-shrink: 0;">
                    <a onclick="BackPage();" style="border: 2px solid #f0ad4e;">
                        <i class="fa fa-arrow-left fa-lg" style="color:#f0ad4e;"></i>
                    </a>
                </div>
                @ViewBag.formname
