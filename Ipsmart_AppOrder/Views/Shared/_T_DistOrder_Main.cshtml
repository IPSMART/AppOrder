@model Improvar.ViewModels.TransactionDistOrder

<div class="table-responsive row sub-top" style="max-height:90%; overflow-y:auto; overflow-x:auto;">
    <table class="table" id="tblMain">
        <thead class="table-header-custom">
            <tr style="background-color: #255994;color: white;">
                @*<th>Sl</th>*@
                <th style="min-width:76px;">Retail Outlet</th>
                @*<th>Area</th>*@
                <th style="min-width:76px;">Brand</th>
                @*<th style="min-width:50px;text-align: right;">T. Sets</th>
                    <th style="min-width:50px;text-align: right;">T. Box</th>*@
                @*<th>T.Pcs</th>*@
                <th style="min-width:76px;">Ord. Det.</th>
                <th style="min-width:40px;">Delete / Skip</th>
                <th style="min-width:40px;">Reason</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ListPendOrd != null)
            {
                for (int i = 0; i <= Model.ListPendOrd.Count - 1; i++)
                {
                    <tr style="background-color:white;">
                        @*<td data-label="Sl">
                                @Html.DisplayFor(model => Model.ListPendOrd[i].SLNO)
                            </td>*@
                        <td data-label="Retail Outlet"  class="readonly-td">
                            @Html.DisplayFor(model => Model.ListPendOrd[i].RTLNM)
                            @Html.HiddenFor(model => Model.ListPendOrd[i].RTLNM, new { id = "RTLNM_" + i })
                            @Html.HiddenFor(model => Model.ListPendOrd[i].RTLCD, new { id = "RTLCD_" + i })
                            @Html.HiddenFor(model => Model.ListPendOrd[i].RTLAUTONO, new { id = "RTLAUTONO_" + i })
                            @Html.HiddenFor(model => Model.ListPendOrd[i].ChildData, new { id = "ChildData_" + i })
                            @Html.HiddenFor(model => Model.ListPendOrd[i].SLNO, new { id = "SLNO_" + i })
                            @Html.HiddenFor(model => Model.ListPendOrd[i].RTLAREA, new { id = "RTLAREA_" + i })
                            @Html.HiddenFor(model => Model.ListPendOrd[i].QNTY, new { id = "QNTY_" + i })
                            @Html.HiddenFor(model => Model.ListPendOrd[i].SET, new { id = "SET_" + i })
                            @Html.HiddenFor(model => Model.ListPendOrd[i].BOX, new { id = "BOX_" + i })
                        </td>
                        @*<td data-label="Area">
                                @Html.DisplayFor(model => Model.ListPendOrd[i].RTLAREA)
                            </td>*@
                        <td data-label="Brand" class="readonly-td">
                            @Html.DisplayFor(model => Model.ListPendOrd[i].BRANDNM)
                            @Html.HiddenFor(model => Model.ListPendOrd[i].BRANDCD, new { id = "BRANDCD_" + i })
                            @Html.HiddenFor(model => Model.ListPendOrd[i].BRANDNM, new { id = "BRANDNM_" + i })
                        </td>
                        @*<td data-label="T.Sets" style="text-align:right">
                                @Html.DisplayFor(model => Model.ListPendOrd[i].SET, new { id = "SET_" + i, @class = "form-control", @readonly = "readonly", @TabIndex = -1, @style = "text-align: right;" })
                            </td>
                            <td data-label="T.Box" style="text-align:right">
                                @Html.DisplayFor(model => Model.ListPendOrd[i].BOX, new { id = "BOX_" + i, @class = "form-control", @readonly = "readonly", @TabIndex = -1, @style = "text-align: right;" })
                            </td>*@
                        <td data-label="Ord.Det" class="readonly-td">
                            <div class="menu">
                                <a onclick="OpenSizeDet('@i');" style="border: 2px solid #28558a;"><i class="fa fa-eye fa-lg" style="color:#28558a;"></i></a>
                                @Html.DisplayFor(model => Model.ListPendOrd[i].ORDDET)
                                @Html.HiddenFor(model => Model.ListPendOrd[i].ORDDET, new { id = "ORDDET_" + i })
                            </div>
                        </td>
                        <td data-label="Skip Order">
                            <div class="menu">
                                @Html.CheckBoxFor(model => Model.ListPendOrd[i].CheckedORDSKIP, new { id = "CheckedORDSKIP_" + i, @TabIndex = -1 })
                                <a onclick="DeleteRowData('@i');" style="border:2px solid red;width:20px;height:20px;">
                                    <i class="fa fa-minus" style="color:red;font-size:15px;"></i>
                                </a>
                            </div>
                        </td>
                        <td data-label="Reason">
                            @Html.TextBoxFor(model => Model.ListPendOrd[i].ORDSKIPREASON, new { id = "ORDSKIPREASON_" + i, @class = "form-control" })
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>