@model Improvar.ViewModels.TransactionDistOrder
<div class="table-responsive row" style="max-height:90%; overflow-y:auto; overflow-x:auto;">
    <table class="table" id="tblItem">
        <thead class="table-header-custom">
            <tr style="background-color: #255994;color: white;">
                @*<th class="sticky-col-left" style="width:50px;">Sl</th>*@
                <th style="min-width:50px;">Style No</th>
                @*<th style="width:50px;text-align: right;">T.Sets</th>
                    <th style="width:50px;text-align: right;">T.Box</th>*@
                <th style="min-width:50px;text-align: right;">Order Set</th>
                <th style="min-width:50px;text-align: right;">Order Qnty</th>
                @*<th>Sizes</th>*@
                <th style="min-width:50px;text-align: right;">Stk Qnty</th>
                <th style="min-width:50px;">Reason</th>
                <th style="min-width:50px;">Remark</th>
                <th style="min-width:50px;">Sizes</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ListPendOrdPopup != null)
            {
                for (int i = 0; i <= Model.ListPendOrdPopup.Count - 1; i++)
                {
                    <tr style="background-color:white;">
                        @*<td class="sticky-col-left" data-label="Sl">
                                @Html.TextBoxFor(model => Model.ListPendOrdPopup[i].SLNO, new { id = "popup_SLNO_" + i, @class = "form-control", @readonly = "readonly", @TabIndex = -1 })
                            </td>*@
                        <td data-label="Style No" class="readonly-td">
                            @Html.DisplayFor(model => Model.ListPendOrdPopup[i].STYLENO)
                            @Html.HiddenFor(model => model.ListPendOrdPopup[i].STYLENO, new { id = "popup_STYLENO_" + i })
                            @Html.HiddenFor(model => model.ListPendOrdPopup[i].RTLAUTONO, new { id = "popup_RTLAUTONO_" + i })
                            @Html.HiddenFor(model => model.ListPendOrdPopup[i].ITCD, new { id = "popup_ITCD_" + i })
                            @Html.HiddenFor(model => model.ListPendOrdPopup[i].SLNO, new { id = "popup_SLNO_" + i })
                            @Html.HiddenFor(model => model.ListPendOrdPopup[i].CheckedORDSKIP, new { id = "popup_CheckedORDSKIP_" + i })
                            @Html.HiddenFor(model => model.ListPendOrdPopup[i].PCSPERSET, new { id = "popup_PCSPERSET_" + i })
                            @Html.HiddenFor(model => model.ListPendOrdPopup[i].PCSPERBOX, new { id = "popup_PCSPERBOX_" + i })
                            @Html.HiddenFor(model => model.ListPendOrdPopup[i].SIZE_COUNT, new { id = "popup_SIZE_COUNT_" + i })
                            @Html.HiddenFor(model => model.ListPendOrdPopup[i].MIXSIZE, new { id = "popup_MIXSIZE_" + i })
                            @Html.HiddenFor(model => model.ListPendOrdPopup[i].TRTLQNTY, new { id = "popup_TRTLQNTY_" + i })
                            @Html.HiddenFor(model => model.ListPendOrdPopup[i].TRTLSET, new { id = "popup_TRTLSET_" + i })
                            @Html.HiddenFor(model => model.ListPendOrdPopup[i].TRTLBOX, new { id = "popup_TRTLBOX_" + i })
                        </td>
                        @*<td data-label="T.Sets">
                                @Html.TextBoxFor(model => Model.ListPendOrdPopup[i].TRTLSET, new { id = "popup_TRTLSET_" + i, @class = "form-control", @readonly = "readonly", @TabIndex = -1 })
                                @Html.HiddenFor(model => model.ListPendOrdPopup[i].TRTLQNTY, new { id = "popup_TRTLQNTY_" + i })
                            </td>*@
                        @*<td data-label="T.Box">
                                @Html.TextBoxFor(model => Model.ListPendOrdPopup[i].TRTLBOX, new { id = "popup_TRTLBOX_" + i, @class = "form-control", @readonly = "readonly", @TabIndex = -1 })
                            </td>*@
                        @if (Model.ListPendOrdPopup[0].CheckedORDSKIP == "Y")
                        {
                            <td data-label="Order Set" class="readonly-td">
                                @Html.TextBoxFor(model => Model.ListPendOrdPopup[i].SET, new { id = "popup_SET_" + i, @class = "form-control",  @readonly = "readonly", @TabIndex = -1, @style = "text-align: right;" })
                            </td>
                        }
                        else
                        {
                            <td data-label="Order Set">
                                @Html.TextBoxFor(model => Model.ListPendOrdPopup[i].SET, new { id = "popup_SET_" + i, @class = "form-control", onchange = "CalculateQnty(" + i + ");", @style = "text-align: right;" })
                            </td>
                        }
                        <td data-label="Order Qnty" class="readonly-td">
                            @Html.TextBoxFor(model => Model.ListPendOrdPopup[i].QNTY, new { id = "popup_QNTY_" + i, @class = "form-control", @readonly = "readonly", @TabIndex = -1, @style = "text-align: right;" })
                        </td>
                        @*<td data-label="Sizes">
                                @Html.TextBoxFor(model => Model.ListPendOrdPopup[i].SIZECD, new { id = "popup_SIZECD_" + i, @class = "form-control", @readonly = "readonly", @TabIndex = -1 })
                            </td>*@
                        @if (Model.ListPendOrdPopup[0].CheckedORDSKIP == "Y")
                        {
                            <td data-label="Stkqnty"  class="readonly-td">
                                @Html.TextBoxFor(model => Model.ListPendOrdPopup[i].TSTKQNTY, new { id = "popup_TSTKQNTY_" + i, @class = "form-control", @style = "text-align: right;", @readonly = "readonly", @TabIndex = -1 })
                            </td>
                            <td data-label="Reason"  class="readonly-td">
                                @Html.TextBoxFor(model => Model.ListPendOrdPopup[i].ORDSKIPREASON, new { id = "popup_ORDSKIPREASON_" + i, @class = "form-control", @readonly = "readonly", @TabIndex = -1 })
                            </td>
                        }
                        else
                        {
                            <td data-label="Stkqnty">
                                @Html.TextBoxFor(model => Model.ListPendOrdPopup[i].TSTKQNTY, new { id = "popup_TSTKQNTY_" + i, @class = "form-control", @style = "text-align: right;" })
                            </td>
                            <td data-label="Reason">
                                @Html.TextBoxFor(model => Model.ListPendOrdPopup[i].ORDSKIPREASON, new { id = "popup_ORDSKIPREASON_" + i, @class = "form-control" })
                            </td>
                        }
                        <td data-label="Remark" class="readonly-td">
                            @Html.DisplayFor(model => Model.ListPendOrdPopup[i].ITREM)
                        </td>
                        <td id="sizecol_@i" data-label="Remark" class="readonly-td">
                            <div class="menu">
                                <a onclick="ModifySizeData('@i');" style="border:2px solid green;width:20px;height:20px;">
                                    <i class="fa fa-pencil" style="color:green;font-size:15px;"></i>
                                </a>
                                @Html.DisplayFor(model => Model.ListPendOrdPopup[i].SIZEDET)
                                @Html.HiddenFor(model => model.ListPendOrdPopup[i].ALLSIZES, new { id = "popup_ALLSIZES_" + i })
                                @Html.HiddenFor(model => model.ListPendOrdPopup[i].SIZEDET, new { id = "popup_SIZEDET_" + i })
                            </div>

                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
