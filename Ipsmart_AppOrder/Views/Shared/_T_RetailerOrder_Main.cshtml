@model Improvar.ViewModels.TransactionRetailOrder
@{
    var tt = System.DateTime.Now.retStr();
}
<script>
    $(document).ready(function () {
        document.querySelector('.swiper-button-next').addEventListener('click', function() {
            // Custom logic before navigating
            $("#NOOFSETS").val("");
            $("#ITREM").val("");
            swiper.slideNext(); // Navigate to the next slide
            // Custom logic after navigating
        });
        document.querySelector('.swiper-button-prev').addEventListener('click', function () {
            // Custom logic before navigating
            $("#NOOFSETS").val("");
            $("#ITREM").val("");
            swiper.slidePrev(); // Navigate to the next slide
            // Custom logic after navigating
        });
    });
</script>
<div class="swiper mySwiper">
    <div class="swiper-wrapper">
        @if (Model.ImageView != null)
            {
                for (int i = 0; i < Model.ImageView.Count; i++)
                {
                <div class="swiper-slide">
                    <span style="display: none" id="itcd_@i">@Model.ImageView[i].ITCD</span>
                    <span style="display: none" id="size_@i">@Model.ImageView[i].SIZES</span>
                    <span style="display: none" id="PCSPERSET_@i">@Model.ImageView[i].PCSPERSET</span>
                    <span style="display: none" id="MIXSIZE_@i">@Model.ImageView[i].MIXSIZE</span>
                    <span style="display: none" id="SIZE_COUNT_@i">@Model.ImageView[i].SIZE_COUNT</span>
                    <span style="display: none" id="PCSPERBOX_@i">@Model.ImageView[i].PCSPERBOX</span>
                    <span style="display: none" id="itrem_@i">@Model.ImageView[i].ITREM</span>
                    <div class="title" id="styleno_@i">@Model.ImageView[i].Desc</div>
                    <img src="@Model.ImageView[i].Url?@tt" id="img_@i" onclick="openimg(this.id);"/>

                </div>
            }
        }
    </div>
    <div class="swiper-button-next"></div>
    <div class="swiper-button-prev"></div>
</div>
<script>
    var swiper = new Swiper(".mySwiper", {
        // autoHeight: true,
        navigation: {
            nextEl: ".swiper-button-next",
            prevEl: ".swiper-button-prev",
        },
    });
</script>
