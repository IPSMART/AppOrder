@model Improvar.ViewModels.VM_SLMDLYREP
@{
    string HEIGHT = "";
    if (Model.DefaultAction == "E")
    {
        HEIGHT = "60vh;";
    }
    else
    {
        HEIGHT = "72vh;";
    }
}
<script type="text/javascript">
    $(document).ready(function () {

        function formatResult(item) {
            if (!item.id) return item.text;
            var parts = item.text.split(String.fromCharCode(181));
            return $('<div><strong>' + parts[0] + '</strong><br/><small>' + parts[1] + '</small></div>');
        }
        function formatResult1(item) {
            if (!item.id) return item.text;
            var parts = item.text.split(String.fromCharCode(181));
            return $('<div><strong>' + parts[0] + '</strong></div>');
        }
        function formatSelection(item) {
            var str = "";
            if (item.text.split(String.fromCharCode(181)).length > 1) {
                return item.text.split(String.fromCharCode(181))[0] + " [" + item.text.split(String.fromCharCode(181))[1] + "]";
            }
            else {
                return item.text.split(String.fromCharCode(181))[0];
            }
        }

        $('.DropdownBOOKUOM').select2({
            width: '100%',
            placeholder: "Select Uom",
            allowClear: true,
            dropdownParent: $('body'),
            templateResult: formatResult1,
            templateSelection: formatSelection,
        });

   
    });
</script>
<script>
    $(function () {

        $(".DTD").datepicker({ dateFormat: "dd/mm/yy", changeMonth: true, changeYear: true, maxDate: '@Model.maxdate', minDate: '@Model.mindate' });

    });
</script>
<div class="table-scroll" style="max-height:@HEIGHT">
    <div class="table-header-fixed">
        <table class="inner-table header-table">
            <tr class="m-header">
                <td>SL.</td>
                <td>Date</td>
                <td>Place From</td>
                <td>Place To</td>
                <td>Km.(Up/Down)</td>
            </tr>
            <tr class="m-header">
                <td>
                    <div class="menu">
                        <a onclick="AddRowData();" style="border:2px solid red;width:20px;height:20px;">
                            <i class="fa fa-plus" style="color:red;font-size:15px;"></i>
                        </a>
                        Conv. fees
                    </div>
                </td>
                <td>T.A.</td>
                <td>D.A.</td>
                <td colspan="2">Booking Qnty</td>
            </tr>
        </table>
    </div>

    <table class="table mobile-4col" style="margin-bottom:0px;">
        <tbody>
            @if (Model.TSLMDLYREP != null)
            {
                for (int i = 0; i < Model.TSLMDLYREP.Count; i++)
                {
                    <tr class="item-card">
                        <td colspan="4">
                            <table id="tblMain" class="inner-table card-wrap">
                                <!-- FIRST VALUE ROW -->
                                <tr class="m-value">
                                    <td>
                                        <div class="menu" style="margin-top: 2px;">
                                            <a onclick="DeleteRowData('@i');" style="border:2px solid red;width:20px;height:20px;">
                                                <i class="fa fa-minus" style="color:red;font-size:15px;"></i>
                                            </a>
                                            <span class="sl-badge">@Model.TSLMDLYREP[i].SLNO</span>
                                        </div>
                                    </td>
                                    <td>
                                        @Html.EditorFor(model => Model.TSLMDLYREP[i].DTD, new { htmlAttributes = new { id = "DTD_" + i, @style = "font-weight:bold;", @class = "DTD form-control ", maxlength = 10, @placeholder = "dd/mm/yyyy" } })
                                        @Html.HiddenFor(model => Model.TSLMDLYREP[i].SLNO, new { id = "SLNO_" + i })
                                    </td>
                                    <td>
                                        @Html.EditorFor(model => Model.TSLMDLYREP[i].PLFROM, new { htmlAttributes = new { id = "PLFROM_" + i, @class = "form-control ", maxlength = 500, @placeholder = "From" } })
                                    </td>
                                    <td>
                                        @Html.EditorFor(model => Model.TSLMDLYREP[i].PLTO, new { htmlAttributes = new { id = "PLTO_" + i, @class = "form-control ", maxlength = 500, @placeholder = "To" } })
                                    </td>
                                    <td>
                                        @Html.EditorFor(model => Model.TSLMDLYREP[i].KMUPDN, new { htmlAttributes = new { id = "KMUPDN_" + i, @class = "form-control ", inputmode = "decimal", type = "tel", maxlength = 4, @onkeypress = "return numericOnly(this,0);",@placeholder = "KM.(Up/Down)" } })
                                        @*@Html.DropDownListFor(model => Model.TSLMDLYREP[i].MODETRAVEL, new SelectList(Model.MODETRAVEL, "Value", "Text", Model.TSLMDLYREP[i].MODETRAVEL), "", new { id = "MODETRAVEL_" + i, @class = "DropdownITMCTG atextBoxFor select_3d" })*@
                                    </td>

                                </tr>

                                <!-- SECOND VALUE ROW -->
                                <tr class="m-value">
                                    <td>
                                        @Html.EditorFor(model => Model.TSLMDLYREP[i].CONVSTR, new { htmlAttributes = new { id = "CONVSTR_" + i, @class = "form-control ", maxlength = 40, inputmode = "decimal", type = "tel", @placeholder = "E.g.0+0+0..", oninput = "return validateCONVSTR(this," + i + ")" } })
                                        @Html.HiddenFor(model => Model.TSLMDLYREP[i].CONVAMT, new { id = "CONVAMT_" + i })
                                    </td>

                                    <td>
                                        @Html.EditorFor(model => Model.TSLMDLYREP[i].TAAMT, new { htmlAttributes = new { id = "TAAMT_" + i, inputmode = "decimal", @class = "form-control text-right numeric-input", maxlength = 10, @onkeypress = "return numericOnly(this,2);", @title = "Only Numeric", @placeholder = "T.A.", oninput = "CalculateTotalTa(" + i + ");" } })
                                    </td>
                                    <td>
                                        @Html.EditorFor(model => Model.TSLMDLYREP[i].DAAMT, new { htmlAttributes = new { id = "DAAMT_" + i, inputmode = "decimal", @class = "form-control text-right numeric-input", maxlength = 10, @onkeypress = "return numericOnly(this,2);", @title = "Only Numeric", @placeholder = "D.A." } })
                                    </td>
                                    <td>
                                        @Html.EditorFor(model => Model.TSLMDLYREP[i].BOOKQTY, new { htmlAttributes = new { id = "BOOKQTY_" + i, inputmode = "decimal", @class = "form-control text-right numeric-input", maxlength = 10, @onkeypress = "return numericOnly(this,2);", @title = "Only Numeric", @placeholder = "Qnty" } })
                                    </td>
                                    <td>
                                        @Html.DropDownListFor(model => Model.TSLMDLYREP[i].BOOKUOM, new SelectList(Model.BOOKUOM, "Value", "Text", Model.TSLMDLYREP[i].BOOKUOM), "", new { id = "BOOKUOM_" + i, @class = "DropdownBOOKUOM atextBoxFor select_3d" })
                                    </td>
                                </tr>
                                <tr class="m-value">
                                    <td colspan="4">
                                        @Html.TextAreaFor(model => Model.TSLMDLYREP[i].REMK, new { id = "REMK_" + i, @class = "form-control ", maxlength = 200, @placeholder = "Details" })
                                    </td>
                                    <td>
                                        @Html.EditorFor(model => Model.TSLMDLYREP[i].TOT_TAAMT, new { htmlAttributes = new { id = "TOT_TAAMT_" + i, inputmode = "decimal", @class = "form-control text-right numeric-input", maxlength = 10, @onkeypress = "return numericOnly(this,2);", @title = "Only Numeric", @placeholder = "Total", @readonly = "readonly" } })
                                    </td>
                                </tr>
                            </table>

                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
