            url: "@Url.Action("OpenPopupSize", PageControllerName)",
            data: $('form').serialize() + "&ParentSerialNo=" + SerialNo + "&Rowindexno=" + index,
            success: function (result) {
                $("#WaitingMode").hide();
                $('#popupItem').html(result);
                document.getElementById('popupTitle').textContent = RTLNM + " " + RTLAREA + " (" + BRANDNM + ")";
                document.getElementById("popup").style.display = "flex";
                if ($("#popup_CheckedORDSKIP_0").val() == 'Y') {
                    document.getElementById("Itemfooter").style.display = "none";
                }
                else {
                    document.getElementById("Itemfooter").style.display = "";
                }
            },
            error: function (XMLHttpRequest, textStatus, errorThrown) {
                $("#WaitingMode").hide();
                msgError(XMLHttpRequest.responseText);
                $("body span h1").remove(); $("#msgbody_error style").remove();
            }
        });
    }

    function CloseSizeDet() {
        debugger;
        var index = $("#hiddenindex").val();
        var SerialNo = $("#SLNO_" + index).val();
        $.ajax({
            type: 'post',
            beforesend: $("#WaitingMode").show(),
            url: "@Url.Action("ClosePopupSize", PageControllerName)",
            data: $('form').serialize() + "&ParentSerialNo=" + SerialNo,
            success: function (result) {
                $("#WaitingMode").hide();
                $('#partialdivMain').html(result);
            },
            error: function (XMLHttpRequest, textStatus, errorThrown) {
                $("#WaitingMode").hide();
                msgError(XMLHttpRequest.responseText);
                $("body span h1").remove(); $("#msgbody_error style").remove();
            }
        });
        document.getElementById("popup").style.display = "none";
    }
    function ClosePopup(id) {
        document.getElementById(id).style.display = "none";

    }
</script>
<script>
    function CalculateQnty(index) {
        var QNTY = 0;
        var NOOFSETS = retFloat($("#popup_SET_" + index).val());
        var PCSPERSET = retFloat($("#popup_PCSPERSET_" + index).val());
        var SIZE_COUNT = retFloat($("#popup_SIZE_COUNT_" + index).val());
        var PCSPERBOX = retFloat($("#popup_PCSPERBOX_" + index).val());
        var MIXSIZE = $("#popup_MIXSIZE_" + index).val();

        var sizedt = "";
        var TQNTY = 0;
        var sizes = $("#popup_ALLSIZES_" + index).val();
        var sizearr = sizes.split(',');
        $.each(sizearr, function (index1, value) {
            var QNTY = 0;
            if (NOOFSETS != 0 && PCSPERSET != 0) {
                if (MIXSIZE == "M") {
                    QNTY = (NOOFSETS * PCSPERSET / SIZE_COUNT);
                }
                else {
                    if (PCSPERBOX != PCSPERSET) {
                        QNTY = (NOOFSETS * PCSPERSET / SIZE_COUNT);
                    } else {
                        QNTY = NOOFSETS * PCSPERSET;
                    }
                }
            }
            else {
                QNTY = (NOOFSETS * PCSPERSET);
            }

            if (sizedt != '') sizedt += ',';
            sizedt += value + '=' + QNTY;

            TQNTY += QNTY;
        });
        $("#popup_QNTY_" + index).val(TQNTY);
        $("#popup_SIZEDET_" + index).val(sizedt);
    }
</script>
<script>
    function DeleteRowData(index) {
        var SLNO = $("#SLNO_" + index).val();

        $.ajax({
            type: 'POST',
            beforesend: $("#WaitingMode").show(),
            url: "@Url.Action("DeleteRow", PageControllerName)",
            data: $('form').serialize() + "&SerialNo=" + SLNO,
            success: function (result) {
                $("#partialdivMain").animate({ marginTop: '0px' }, 50);
                $("#partialdivMain").html(result);
                $("#WaitingMode").hide();
            },
            error: function (XMLHttpRequest, textStatus, errorThrown) {
                $("#WaitingMode").hide();
                msgError(XMLHttpRequest.responseText);
                $("body span h1").remove(); $("#msgbody_error style").remove();
            }
        });

    }
    function ModifySizeData(index) {
        $("#hiddenindexitem").val(index);
        var SLNO = $("#popup_SLNO_" + index).val();
        var CheckedORDSKIP = $("#popup_CheckedORDSKIP_0").val();

        var itrem = $("#popup_ORDSKIPREASON_" + index).val();;
        var tr = "";
        var styleno = $("#popup_STYLENO_" + index).val();
        var allsizearr = $("#popup_ALLSIZES_" + index).val().split(',');

        let sizearr = {};
        $("#popup_SIZEDET_" + index).val().replace(/[{}]/g, "").split(",").forEach(item => {
            let parts = item.split("=");
            let size = parts[0];
            let qty = retFloat(parts[1]);
            sizearr[size] = qty;
        });

        $.each(allsizearr, function (index, value) {
            let qnty = sizearr[value];
            var size = value;
            tr += '<tr><td class="sticky-col-left readonly-td">' + size + '</td>';
            if (CheckedORDSKIP == 'Y') {
                tr += '<td class="readonly-td"> <input type="number" value="' + qnty + '"  class="form-control" style="width:100%;margin-top: 0px;" readonly="readonly"/></td>';
            }
            else {
                tr += '<td> <input type="number" value="' + qnty + '"  class="form-control" style="width:100%;margin-top: 0px;"/></td>';
            }
            tr += '</tr>';
        });
        var table = "";

        table += '<div class="table-responsive row" style="max-height:60%; overflow-y:auto;margin-bottom:0px;">';
        table += '<table class="table table-striped" id="popuptblSizes">';
        table += '<thead class="table-header-custom">';
        table += '<tr style="background-color: #255994;color: white;">';
        table += '<th class="sticky-col-left" style="width:50px;">Size</th>';
        table += '<th>Qnty</th>';
        table += '</tr>';
        table += '</thead>';
        table += '<tbody>' + tr + '</tbody>';
        table += '</table>';
        table += '</div>';
        $("#popupSize").html(table);
        $("#popupITREM").val(itrem);
        document.getElementById('popupTitle1').textContent = styleno;
        document.getElementById("popup1").style.display = "flex";
        if (CheckedORDSKIP == 'Y') {
            document.getElementById("Sizefooter").style.display = "none";
        }
        else {
            document.getElementById("Sizefooter").style.display = "";
        }
    }
    function UpdateItemSize() {
        debugger;
        var indexitem = $("#hiddenindexitem").val();
        var itrem = $("#popupITREM").val();

        var sizedt = "";
        var tqnty = 0;
        $('#popuptblSizes > tbody  > tr').each(function () {
            var SIZE = $(this).find("td").eq(0).html();
            var QNTY = $(this).find("td:eq(1) input[type='number']").val();
            if (retFloat(QNTY) != 0) {
                if (sizedt != '') sizedt += ',';
                sizedt += SIZE + '=' + retFloat(QNTY);
                tqnty += retFloat(QNTY);

            }
        });

        var PCSPERSET = retFloat($("#popup_PCSPERSET_" + indexitem).val());
        var set = ConvPcstoSet(tqnty, PCSPERSET);

        var ALLSIZES = $("#popup_ALLSIZES_" + indexitem).val();
        var str = "";
        str += '<div class="menu">';
        str += '<a onclick="ModifySizeData(' + indexitem + ');" style="border:2px solid green;width:20px;height:20px;">';
        str += '<i class="fa fa-pencil" style="color:green;font-size:15px;"></i>';
        str += '</a>';
        str += sizedt;
        str += '<input id="popup_ALLSIZES_' + indexitem + '" name="ListPendOrdPopup[' + indexitem + '].ALLSIZES" type="hidden" value="' + ALLSIZES + '">';
        str += '<input id="popup_SIZEDET_' + indexitem + '" name="ListPendOrdPopup[' + indexitem + '].SIZEDET" type="hidden" value="">';
        str += '</div>';
        $("#sizecol_" + indexitem).html(str);

        $("#popup_SIZEDET_" + indexitem).val(sizedt);
        $("#popup_QNTY_" + indexitem).val(tqnty);
        $("#popup_SET_" + indexitem).val(set);
        $("#popup_ORDSKIPREASON_" + indexitem).val(itrem);


        ClosePopup('popup1');
    }
</script>
