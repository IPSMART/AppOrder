<script>
    function TakeOrder() {
        debugger;
        var index1 = swiper.realIndex;
        var sizes = $("#size_" + index1).html();
        var sizearr = sizes.split(',');

        var NOOFSETS = retFloat($("#NOOFSETS").val());
        var PCSPERSET = retFloat($("#PCSPERSET_" + index1).html());
        var MIXSIZE = $("#MIXSIZE_" + index1).html();
        var PCSPERBOX = retFloat($("#PCSPERBOX_" + index1).html());
        var SIZE_COUNT = sizearr.length-1;
        $('#tblSizes > tbody').html('');
        $.each(sizearr, function (index, value) {
            var QNTY = 0;
            if (NOOFSETS != 0 && PCSPERSET != 0) {
                if (MIXSIZE == "M") {
                    QNTY = (NOOFSETS * PCSPERSET / SIZE_COUNT);
                }
                else {
                    if (PCSPERBOX != PCSPERSET) {
                        QNTY = (NOOFSETS * PCSPERSET / SIZE_COUNT);
                    } else {
                        QNTY = NOOFSETS * PCSPERSET;
                    }
                }
            }
            else {
                QNTY = (NOOFSETS * PCSPERSET)
            }

            var tr = '<tr><td>' + value + '</td><td> <input type="number" value="' + QNTY + '"  class="form-control"/></td></tr>';
            $('#tblSizes > tbody:last-child').append(tr);
        });
    }
    function AddtoCart() {
        if(retFloat($("#NOOFSETS").val()) == 0)
        {
            alert('Enter No. Of Sets !!');
            return false;
        }
        TakeOrder();
        var index = swiper.realIndex;
        var itcd = $("#itcd_" + index).html();
        var styleno = $("#styleno_" + index).html();
        var sizedt = '';
        var itcdexist=false;
        if ($('#tblCart > tbody > tr td:contains("' + itcd + '")').length > 0) {
            itcdexist = true;
        }
        if(itcdexist == true)
        {
            $('#tblSizes > tbody').html('');
            alert('this style already added in cart !!');
            return false;
        }
        else
        {
            //getLocation();
            var NoOfItem=retFloat($("#NoOfItem").val());
            NoOfItem++;
            var TQnty=retFloat($("#TQnty").val());
            $('#tblSizes > tbody  > tr').each(function () {
                var SIZE = $(this).find("td").eq(0).html();
                var QNTY = $(this).find("td:eq(1) input[type='number']").val();
                if (QNTY != '') {
                    if (sizedt != '') sizedt += ',';
                    sizedt += SIZE + '=' + QNTY;
                    TQnty +=retFloat(QNTY);
                }
            });
            var tr = '<tr><td>' + styleno + '</td><td>' + sizedt + '</td><td colspan="2">' + itcd + '</td></tr>';
            $('#tblCart > tbody').prepend(tr);
            $('#tblSizes > tbody').html('');
            $("#NOOFSETS").val("");
            $("#NoOfItem").val(NoOfItem);
            $("#TQnty").val(TQnty);
            $('#cartsummary').text(NoOfItem+"("+TQnty+")");
            updateVisibility(@VisibleRow);
        }
    }
    function toggleRows(btnid) {
        isExpanded = false;
        if (btnid == "btnShowMore") {
            ShowMore();
            $("#btnShowLess").show();
            $("#btnShowMore").hide();
        }
        else {
            ShowLess();
            $("#btnShowLess").hide();
            $("#btnShowMore").show();
        }
    }
</script>
<script>
    function ShowMore() {
        const rows = document.querySelectorAll('#tblCart tr');
        visibleCount = rows.length;
        updateVisibility(visibleCount);
    }
    function ShowLess() {
        visibleCount = @VisibleRow;
        updateVisibility(visibleCount);
    }
    function updateVisibility(visibleCount) {
        const rows = document.querySelectorAll('#tblCart tr');
        if (rows.length > 1) {
            rows.forEach((row, index) => {
                if (index <= visibleCount) {
                    row.classList.remove('hidden');
                } else {
                    row.classList.add('hidden');
                }
            });
        }
    }
</script>
<script>
    function SaveData() {
        $("#WaitingMode").show();
        getLocation(function (latlot) {
            if (latlot != "") {
                var LAT = returncolvalue(latlot, "LAT");
                var LOT = returncolvalue(latlot, "LOT");

                $("#GPSLAT").val(LAT);
                $("#GPSLOT").val(LOT);
            }
            //need to open
            //if (!emptyFieldCheck("Location not found,Save again", "GPSLOT")) {
            //    alert('Location not found,Save again!');
            //    //getLocation();
            //    $("#WaitingMode").hide();
            //    return false;
            //}
            //if (!emptyFieldCheck("Location not found,Save again", "GPSLAT")) {
            //    alert('Location not found,Save again!');
            //    //getLocation();
            //    $("#WaitingMode").hide();
            //    return false;
            //}
            if (!emptyFieldCheck("Please select retailer!", "RTLCD")) {
                alert('retailer not found!');
                $("#WaitingMode").hide();
                return false;
            }
            var hdnData1 = '';
            $('#tblCart > tbody  > tr').each(function () {
                var ITCD = $(this).find("td").eq(0).html();
                var QNTY = $(this).find("td").eq(1).html();
                var SIZE = $(this).find("td").eq(2).html();
                if (hdnData1 != '') hdnData1 += ',';
                hdnData1 += "{ 'ITCD': '" + ITCD + "', 'sizes': '" + SIZE + "'  }";
            });

            console.log(hdnData1);
            if (hdnData1 == '') { msgInfo('Data Not found'); return false; }
            $("#ITEMDETAIL_JSTR").val('[' + hdnData1 + ']');

            $.ajax({
                type: 'post',
                url: "@Url.Action("SAVE", PageControllerName)",
                data: $('form').serialize(),
                success: function (result) {
                    if (result == '1') {
                        alert('Data Saved Successfully !!');
                        window.location.href = "@Url.Action("M_GrpMast", "M_GrpMast", new { US = Model.UNQSNO_ENCRYPTED })";
                        if (newWindow) {
                            window.open('', '_self'); // Required for some browsers
                            window.close(); // Attempt to close current window
                        } else {
                            alert("Popup blocked! Please allow popups for this website.");
                        }
                    }
                    else{
                        alert(result);
                        $("#WaitingMode").hide();
                    }
                },
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                    $("#WaitingMode").hide();
                    msgError(XMLHttpRequest.responseText);
                    $("body span h1").remove(); $("#msgbody_error style").remove();
                }
            });
        });

    }
</script>
<script>
    function increment(id) {
        var input = document.getElementById(id);
        input.stepUp();
    }
    function decrement(id) {
        var input = document.getElementById(id);
        input.stepDown();
    }
</script>
<script>
   function OpenHome(){
       window.location.href = "@Url.Action("M_GrpMast", "M_GrpMast", new { US = Model.UNQSNO_ENCRYPTED })";
       if (newWindow) {
           window.open('', '_self'); // Required for some browsers
           window.close(); // Attempt to close current window
       } else {
           alert("Popup blocked! Please allow popups for this website.");
       }
    }
</script>
