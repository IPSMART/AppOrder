<script>
    function TakeOrder() {
        debugger;
        var index1 = swiper.realIndex;
        var sizes = $("#size_" + index1).html();
        var sizearr = sizes.split(',');

        var NOOFSETS = retFloat($("#NOOFSETS").val());
        var ITREM = $("#ITREM").val();
        var PCSPERSET = retFloat($("#PCSPERSET_" + index1).html());
        var MIXSIZE = $("#MIXSIZE_" + index1).html();
        var PCSPERBOX = retFloat($("#PCSPERBOX_" + index1).html());
        var SIZE_COUNT = sizearr.length;
        $('#tblSizes > tbody').html('');
        $.each(sizearr, function (index, value) {
            var QNTY = 0;
            if (NOOFSETS != 0 && PCSPERSET != 0) {
                if (MIXSIZE == "M") {
                    QNTY = (NOOFSETS * PCSPERSET / SIZE_COUNT);
                }
                else {
                    if (PCSPERBOX != PCSPERSET) {
                        QNTY = (NOOFSETS * PCSPERSET / SIZE_COUNT);
                    } else {
                        QNTY = NOOFSETS * PCSPERSET;
                    }
                }
            }
            else {
                QNTY = (NOOFSETS * PCSPERSET)
            }
            QNTY=retFloat(QNTY.toFixed(3));
            var tr = '<tr><td>' + value + '</td><td> <input type="number" value="' + QNTY + '"  class="form-control"/></td><td> <input type="text" value="' + ITREM + '"  class="form-control"/></td></tr>';
            $('#tblSizes > tbody:last-child').append(tr);
        });
    }
    function AddtoCart() {
        if(retFloat($("#NOOFSETS").val()) == 0)
        {
            alert('Enter No. Of Sets !!');
            return false;
        }
        TakeOrder();
        var index = swiper.realIndex;
        var itrem =  $("#ITREM").val();
        var itcd = $("#itcd_" + index).html();
        var styleno = $("#styleno_" + index).html();
        var sizes = $("#size_" + index).html();
        var sizedt = '';
        var itcdexist=false;
        if ($('#tblCart > tbody > tr td:contains("' + itcd + '")').length > 0) {
            itcdexist = true;
        }
        if(itcdexist == true)
        {
            $('#tblSizes > tbody').html('');
            alert('this style already added in cart !!');
            return false;
        }
        else
        {
            var NoOfItem=retFloat($("#NoOfItem").val());
            NoOfItem++;
            var TQnty=retFloat($("#TQnty").val());
            var qnty=0;
            $('#tblSizes > tbody  > tr').each(function () {
                var SIZE = $(this).find("td").eq(0).html();
                var QNTY = $(this).find("td:eq(1) input[type='number']").val();
                if (QNTY != '') {
                    if (sizedt != '') sizedt += ',';
                    sizedt += SIZE + '=' + QNTY;
                    TQnty +=retFloat(QNTY);
                    qnty +=retFloat(QNTY);
                }
            });
            TQnty=retFloat(TQnty.toFixed(3));
            qnty=retFloat(qnty.toFixed(3));
            var icon ='<div class="menu" style="float:right;">';
            icon +='<a onclick="ModifyCart(\'' + itcd + '\');" style="border:2px solid #5cb85c;width:20px;height:20px;">';
            icon +='<i class="fa fa-pencil" style="color:#5cb85c;font-size:15px;"></i>';
            icon +='</a>';
            icon +='<a onclick="DeleteCart(\'' + itcd + '\');" style="border:2px solid red;width:20px;height:20px;">';
            icon +='<i class="fa fa-minus" style="color:red;font-size:15px;"></i>';
            icon +='</a>';
            icon +='</div>';
            var tr = '<tr data-qnty='+qnty+' data-allsizes='+sizes+' data-sizeqnty='+sizedt+' >';
            tr += '<td>' + styleno + '</td>';
            tr += '<td><span style="font-weight: bold;">'+qnty+'</span> (<span style="font-size: 10px;">'+ sizedt + '</span>)</td>';
            //tr += '<td>' + itrem + '</td>';
            tr += '<td><input type="text" value="' + itrem + '" style="width:100%;margin-top: 0px;" class="form-control" ></td>';

            //tr += '<td><input class="form-control  text-box single-line" data-val="true" data-val-length="The field popupITREM must be a string with a maximum length of 50." data-val-length-max="50" id="popupITREM" maxlength="50" name="popupITREM" placeholder="Remarks" style="font-weight:bold;font-size:15px;" type="text" value="' + itrem + '"></td>';
            tr += '<td>' + itcd + '</td>';
            tr += '<td class="sticky-col-right">'+icon+'</td>';
            tr += '</tr>';
            $('#tblCart > tbody').prepend(tr);
            $('#tblSizes > tbody').html('');
            $("#NOOFSETS").val("");
            $("#ITREM").val("");
            $("#TQnty").val(TQnty);
            $("#NoOfItem").val(NoOfItem);
            $('#cartsummary').text(NoOfItem+"("+TQnty+")");
            updateVisibility(@VisibleRow);
        }
    }
    function toggleRows(btnid) {
        isExpanded = false;
        if (btnid == "btnShowMore") {
            ShowMore();
            $("#btnShowLess").show();
            $("#btnShowMore").hide();
        }
        else {
            ShowLess();
            $("#btnShowLess").hide();
            $("#btnShowMore").show();
        }
    }
    function ModifyCart(itcd)
    {
        debugger;

        $("#UpdateItcd").val(itcd);
        var styleno="",itrem="";
        var tr = "";
        $('#tblCart > tbody  > tr').each(function () {
            let row = $(this);
            row.find("td").each(function () {
                if ($(this).text().trim() === itcd) { // exact match
                    styleno=row.find("td").eq(0).text();
                    var allsizearr= row[0].dataset.allsizes.split(',');
                    //var sizearr = row.find("td").eq(1).text().split(',');

                    let sizearr = {};
                    row[0].dataset.sizeqnty.replace(/[{}]/g, "").split(",").forEach(item => {
                        let parts = item.split("=");
                        let size = parts[0];
                        let qty = retFloat(parts[1]);
                        sizearr[size] = qty;
                    });

                    $.each(allsizearr, function (index, value) {
                        //var size=value.split('=')[0];
                        //var qnty=value.split('=')[1];
                        let qnty = sizearr[value];
                        var size=value;
                        //tr += '<tr><td class="sticky-col-left">' + size + '</td><td> <input type="text" value="' + qnty + '"  class="form-control" style="width:100%;margin-top: 0px;" maxlength="12" onkeypress="return numericOnly(this,3);" /></td></tr>';
                        tr += '<tr><td class="sticky-col-left">' + size + '</td><td> <input type="number" value="' + qnty + '"  class="form-control" style="width:100%;margin-top: 0px;" maxlength="12" onkeypress="return numericOnly(this,3);" /></td></tr>';
                        itrem = row.find("td").eq(2).find('input').val();
                    });
                }
            });
        });
        var table = "";

        table += '<div class="table-responsive row" style="max-height:60%; overflow-y:auto;margin-bottom:0px;">';
        table += '<table class="table table-striped" id="popuptblSizes">';
        table += '<thead class="table-header-custom">';
        table += '<tr style="background-color: #255994;color: white;">';
        table += '<th class="sticky-col-left" style="width:50px;">Size</th>';
        table += '<th>Qnty</th>';
        table += '</tr>';
        table += '</thead>';
        table += '<tbody>'+tr+'</tbody>';
        table += '</table>';
        table += '</div>';
        $("#popupSize").html(table);
        $("#popupITREM").val(itrem);
        document.getElementById('popupTitle').textContent = styleno;
        document.getElementById("popup").style.display = "flex";
    }
    function ClosePopup(){
        document.getElementById("popup").style.display = "none";

    }
    function UpdateCart() {
        debugger;
        var itcd = $("#UpdateItcd").val();
        var itrem =  $("#popupITREM").val();
        var sizedt ="";

        var qnty=0;
        $('#popuptblSizes > tbody  > tr').each(function () {
            var SIZE = $(this).find("td").eq(0).html();
            var QNTY = $(this).find("td:eq(1) input[type='number']").val();
            if (retFloat(QNTY) != 0) {
                if (sizedt != '') sizedt += ',';
                sizedt += SIZE + '=' + retFloat(QNTY);
                qnty +=retFloat(QNTY);

            }
        });
        qnty=retFloat(qnty.toFixed(3));
        var TQnty=0,NoOfItem=0;

        $('#tblCart > tbody  > tr').each(function () {
            let row = $(this);
            NoOfItem++;
            row.find("td").each(function () {
                if ($(this).text().trim() === itcd) { // exact match
                    var sizes='<span style="font-weight: bold;">'+qnty+'</span> (<span style="font-size: 10px;">'+sizedt+'</span>)';
                    row.find("td").eq(1).html(sizes);
                    row.find("td").eq(2).find('input').val(itrem);
                    row[0].dataset.qnty=qnty;
                    row[0].dataset.sizeqnty=sizedt;
                }
            });
            TQnty += retFloat(row[0].dataset.qnty);

        });
        TQnty=retFloat(TQnty.toFixed(3));

        $("#TQnty").val(TQnty);
        $("#NoOfItem").val(NoOfItem);
        $('#cartsummary').text(NoOfItem+"("+TQnty+")");
        updateVisibility(@VisibleRow);
        ClosePopup();
    }
    function DeleteCart(itcd)
    {
        debugger;
        var TQnty=0,NoOfItem=0;
        $("#tblCart tbody tr").each(function() {
            if ($(this).find("td").eq(3).text().trim() === itcd) {
                $(this).remove();
            }
            else
            {
                TQnty += retFloat($(this)[0].dataset.qnty);
                NoOfItem++;
            }
        });
        TQnty=retFloat(TQnty.toFixed(3));

        $("#TQnty").val(TQnty);
        $("#NoOfItem").val(NoOfItem);
        $('#cartsummary').text(NoOfItem+"("+TQnty+")");
        updateVisibility(@VisibleRow);
    }
</script>
<script>
    function ShowMore() {
        const rows = document.querySelectorAll('#tblCart tr');
        visibleCount = rows.length;
        updateVisibility(visibleCount);
    }
    function ShowLess() {
        visibleCount = @VisibleRow;
        updateVisibility(visibleCount);
    }
    function updateVisibility(visibleCount) {
        const rows = document.querySelectorAll('#tblCart tr');
        if (rows.length > 1) {
            rows.forEach((row, index) => {
                if (index <= visibleCount) {
                    row.classList.remove('hidden');
                } else {
                    row.classList.add('hidden');
                }
            });
        }
    }
</script>
