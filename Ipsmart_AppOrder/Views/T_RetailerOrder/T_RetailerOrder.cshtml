<script>
    function TakeOrder() {
        debugger;
        var index1 = swiper.realIndex;
        var sizes = $("#size_" + index1).html();
        var sizearr = sizes.split(',');

        var NOOFSETS = retFloat($("#NOOFSETS").val());
        var PCSPERSET = retFloat($("#PCSPERSET_" + index1).html());
        var MIXSIZE = $("#MIXSIZE_" + index1).html();
        var PCSPERBOX = retFloat($("#PCSPERBOX_" + index1).html());
        var SIZE_COUNT = sizearr.length-1;
        $('#tblSizes > tbody').html('');
        $.each(sizearr, function (index, value) {
            var QNTY = 0;
            if (NOOFSETS != 0 && PCSPERSET != 0) {
                if (MIXSIZE == "M") {
                    QNTY = (NOOFSETS * PCSPERSET / SIZE_COUNT);
                }
                else {
                    if (PCSPERBOX != PCSPERSET) {
                        QNTY = (NOOFSETS * PCSPERSET / SIZE_COUNT);
                    } else {
                        QNTY = NOOFSETS * PCSPERSET;
                    }
                }
            }
            else {
                QNTY = (NOOFSETS * PCSPERSET)
            }

            var tr = '<tr><td>' + value + '</td><td> <input type="number" value="' + QNTY + '"  class="form-control"/></td></tr>';
            $('#tblSizes > tbody:last-child').append(tr);
        });
    }
</script>
<script>
    function AddtoCart() {
        getLocation();
        if(retFloat($("#NOOFSETS").val()) == 0)
        { 
            alert('Enter No. Of Sets !!');
            return false; 
        }
        TakeOrder();
        var index = swiper.realIndex;
        var itcd = $("#itcd_" + index).html();
        var styleno = $("#styleno_" + index).html();
        var sizedt = '';
        var itcdexist=false;
        if ($('#tblCart > tbody > tr td:contains("' + itcd + '")').length > 0) {
            itcdexist = true;
        }
        if(itcdexist == true)
        { 
            $('#tblSizes > tbody').html('');
            alert('this style already added in cart !!');
            return false; 
        }
        else
        {
            var NoOfItem=retFloat($("#NoOfItem").val());
            NoOfItem++;
            var TQnty=retFloat($("#TQnty").val());
            $('#tblSizes > tbody  > tr').each(function () {
                var SIZE = $(this).find("td").eq(0).html();
                var QNTY = $(this).find("td:eq(1) input[type='number']").val();
                if (QNTY != '') {
                    if (sizedt != '') sizedt += ',';
                    sizedt += SIZE + '=' + QNTY;
                    TQnty +=retFloat(QNTY);
                }
            });
            var tr = '<tr><td>' + itcd + '</td><td>' + styleno + '</td><td>' + sizedt + '</td></tr>';
            $('#tblCart > tbody').prepend(tr);
            $('#tblSizes > tbody').html('');
            $("#NOOFSETS").val("");
            $("#NoOfItem").val(NoOfItem);
            $("#TQnty").val(TQnty);
            $('#cartsummary').text(NoOfItem+"("+TQnty+")");
            updateVisibility(@VisibleRow);
        }     
    }
    function toggleRows(btnid) {
        const button = document.querySelector(".toggle-button");
        isExpanded = false;
        if (btnid == "btnShowMore") {
            ShowMore();
            $("#btnShowLess").show();
            $("#btnShowMore").hide();
        }
        else {
            ShowLess();
            $("#btnShowLess").hide();
            $("#btnShowMore").show();
        }

    }
    function ShowMore() {
        const rows = document.querySelectorAll('#tblCart tr');
        visibleCount = rows.length;
        updateVisibility(visibleCount);
    }
    function ShowLess() {
        visibleCount = @VisibleRow;
        updateVisibility(visibleCount);
    }
    function updateVisibility(visibleCount) {
        const rows = document.querySelectorAll('#tblCart tr');
        if (rows.length > 1) {
            rows.forEach((row, index) => {
                if (index <= visibleCount) {
                    row.classList.remove('hidden');
                } else {
                    row.classList.add('hidden');
                }
            });
        }
    }
    function SaveData() {
        $("#WaitingMode").show(),
        getLocation();
        if (!emptyFieldCheck("Location not found,Save again", "GEOLONGITUDE")) {
            alert('Please select retailer !');
            getLocation();
            $("#WaitingMode").hide();
            return false;
        }
        if (!emptyFieldCheck("Location not found,Save again", "GEOLATITUDE")) {
            alert('Please select retailer !');
            getLocation();
            $("#WaitingMode").hide();
            return false;
        }
        if (!emptyFieldCheck("Please select retailer!", "RetailerCode")) {
            alert('retailer not found!');
            $("#WaitingMode").hide();
            return false;
        }
        var hdnData1 = '';
        $('#tblCart > tbody  > tr').each(function () {
            var ITCD = $(this).find("td").eq(0).html();
            var QNTY = $(this).find("td").eq(1).html();
            var SIZE = $(this).find("td").eq(2).html();
            if (hdnData1 != '') hdnData1 += ',';
            hdnData1 += "{ 'ITCD': '" + ITCD + "', 'sizes': '" + SIZE + "'  }";
        });

        console.log(hdnData1);
        if (hdnData1 == '') { msgInfo('Data Not found'); return false; }
        $("#ITEMDETAIL_JSTR").val('[' + hdnData1 + ']');

        $.ajax({
            type: 'post',
            url: "@Url.Action("SAVE", PageControllerName)",
            data: $('form').serialize(),
            success: function (result) {
                if (result == '1') {
                    alert('Data Saved Successfully !!');
                    location.reload();
                }
                else{
                    alert(result);
                    $("#WaitingMode").hide();
                }
            },
            error: function (XMLHttpRequest, textStatus, errorThrown) {
                $("#WaitingMode").hide();
                msgError(XMLHttpRequest.responseText);
                $("body span h1").remove(); $("#msgbody_error style").remove();
            }
        });
    }
</script>
<script>
    function GetBrandInfo(id) {
        debugger;
        $.ajax({
            type: 'POST',
            beforesend: $("#WaitingMode").show(),
            url: "@Url.Action("GetBrandDetails", PageControllerName)",
            data: $('form').serialize(),
            success: function (result) {
                var MSG = result.indexOf('#helpDIV');
                if (MSG >= 0) {
                    ClearAllTextBoxes("BrandCode,BrandName");
                    $('#SearchFldValue').val("BrandCode");
                    $('#helpDIV').html(result);
                    $('#ReferanceFieldID').val("BrandCode,BrandName");
                    $('#ReferanceColumn').val("1/0");
                    $('#helpDIV_Header').html("Brand Details");
                }
                else {
                    var MSG = result.indexOf(String.fromCharCode(181));
                    if (MSG >= 0) {
                        $("#BrandCode").val(returncolvalue(result, "BRANDCD"));
                        $("#BrandName").val(returncolvalue(result, "BRANDNM"));
                        hlpblurval = "BrandCode";//id;
                    }
                    else {
                        $('#helpDIV').html("");
                        msgInfo("" + result + " !");
