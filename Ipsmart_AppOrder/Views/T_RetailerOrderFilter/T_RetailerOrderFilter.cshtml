                            <input type="button" style="margin-top: -10px;padding: 2px 7px 1px 7px;" onclick="RetailMaster()" class="btn btn-sm btn-info" value="Add" id="BtnAddRtl" />
                            <input type="button" style="margin-top: -10px;padding: 2px 7px 1px 7px;" onclick="EditeRetailMaster()" class="btn btn-sm btn-info" value="Modify" id="BtnModiRtl" disabled/>

                            @*<a onclick="RetailMaster();" style="pointer-events:none;color:#428bca8c" id="BtnAddRtl">
                                <span class="glyphicon glyphicon-plus-sign" style="font-size:20px;margin-top:3px;"></span>
                            </a>*@
                            @*<a href="../M_RetailOutlet/M_RetailOutlet?op=A&MNUDET=UFJPRE1BU1R+MH5NX0dycE1hc3R+fk1+MH4wfkFFRFY=&US=@US&DC=&MP=" target="_blank" style="pointer-events:none;color:#428bca8c" id="BtnAddRtl">
                        <span class="glyphicon glyphicon-plus-sign" style="font-size:20px;margin-top:3px;"></span>
                    </a>*@
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="editor-field" style="margin-top: 4px;">
                            @Html.DropDownListFor(model => model.RetailerCode, new SelectList(Model.ListRetailer, "Value", "Text", Model.RetailerCode), "Select", new { @class = "form-control select2", id = "RetailerCode", @onchange = "ChkMailNumber();" })
                            @Html.HiddenFor(model => model.RetailerName, new { id = "RetailerName" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-2">
