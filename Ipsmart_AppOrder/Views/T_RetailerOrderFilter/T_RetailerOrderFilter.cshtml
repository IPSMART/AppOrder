@model Improvar.ViewModels.VMRetailOrder
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    string PageControllerName = "T_RetailerOrderFilter";
    string US = Model?.UNQSNO_ENCRYPTED;

}
<link href="~/Content/swiper-bundle.min.css" rel="stylesheet" />
<script src="~/Scripts/swiper-bundle.min.js"></script>
<script src="~/Scripts/sweetalert2@11.js"></script>

<script>
    window.addEventListener("unload", function () { });
    
    // If this page loads and reloadOnBack flag is set, refresh
    if (sessionStorage.getItem("reloadOnBack") === "true") {
        sessionStorage.removeItem("reloadOnBack");
        location.reload();
    }
    window.onload = function () {
        document.getElementById("WaitingMode").style.display = "none";
    };
</script>
<script type="text/javascript">
    $(document).ready(function () {
        getLocation(function (loc) {
            if (loc) {
                $("#GEOLATITUDE").val(loc.lat);
                $("#GEOLONGITUDE").val(loc.lng);
                //showCustomAlert("info", "Location: " + loc.lat + ", " + loc.lng);
            }
            else {
                return false;
                //showCustomAlert("info", "Location: ");
            }
        });

        function formatResult(item) {
            if (!item.id) return item.text;
            var parts = item.text.split(String.fromCharCode(181));
            return $('<div><strong>' + parts[0] + '</strong><br/><small>' + parts[1] + '</small></div>');
        }

        function formatSelection(item) {
            return item.text.split(String.fromCharCode(181))[0];
        }

        $('#Dstbrslcd').select2({
            width: '100%',
            placeholder: "Select Distributor",
            allowClear: true,
            templateResult: formatResult,
            templateSelection: formatSelection,
        });

        $('#Dstbrslcd').change(function () {
            
            var selectedText = $("#Dstbrslcd option:selected").text();
            $('#Dstbrslnm').val(selectedText);
        });

        $('#RetailerCode').select2({
            width: '100%',
            placeholder: "Select Retailer",
            allowClear: true,
            templateResult: formatResult,
            templateSelection: formatSelection,
        });

        $('#RetailerCode').change(function () {
            
            var selectedText = $("#RetailerCode option:selected").text();
            $('#RetailerName').val(selectedText);
        });

        $('#BrandCode').select2({
            width: '100%',
            placeholder: "Select Brand",
            allowClear: true,
            closeOnSelect: false,
        });

        $('#BrandCode').change(function () {
            
            var selectedTexts = $('#BrandCode option:selected').map(function () {
                return $(this).text();
            }).get().join(', '); // You can change delimiter if needed

            $('#BrandName').val(selectedTexts);

        });

        $('#GroupCode').select2({
            width: '100%',
            placeholder: "Select Group",
            allowClear: true,
            closeOnSelect: false,
        });

        $('#GroupCode').change(function () {
            
            var selectedTexts = $('#GroupCode option:selected').map(function () {
                return $(this).text();
            }).get().join(', '); // You can change delimiter if needed

            $('#GroupName').val(selectedTexts);

        });

        $('#CollCode').select2({
            width: '100%',
            placeholder: "Select Collection",
            allowClear: true,
            closeOnSelect: false,
        });

        $('#CollCode').change(function () {
            
            var selectedTexts = $('#CollCode option:selected').map(function () {
                return $(this).text();
            }).get().join(', '); // You can change delimiter if needed

            $('#CollName').val(selectedTexts);

        });

        var Dstbrslcd = $("#Dstbrslcd").val();
        if (Dstbrslcd) {
            $("#BtnAddRtl").prop("disabled", false);
            //$('#BtnAddRtl').css('pointer-events', 'auto');
            //$('#BtnAddRtl').css('color', '#428bca');
        }
        else {
            $("#BtnAddRtl").prop("disabled", true);
            //$('#BtnAddRtl').css('pointer-events', 'none');
            //$('#BtnAddRtl').css('color', 'rgba(66, 139, 202, 0.55)');
        }
    });
</script>
<script>
    function BindRetailer() {
        

        var Dstbrslcd = $("#Dstbrslcd").val();
        if (Dstbrslcd) {
            $("#BtnAddRtl").prop("disabled", false);
            //$('#BtnAddRtl').css('pointer-events', 'auto');
            //$('#BtnAddRtl').css('color', '#428bca');
        }
        else {
            $("#BtnAddRtl").prop("disabled", true);
            //$('#BtnAddRtl').css('pointer-events', 'none');
            //$('#BtnAddRtl').css('color', 'rgba(66, 139, 202, 0.55)');
        }
        $('#RetailerCode').empty().append('<option value="">Select Retailer</option>');
        $.ajax({
            url: "@Url.Action("BindRetailerData", PageControllerName)",
            type: 'POST',
        beforesend: $("#WaitingMode").show(),
        data: { Distributor: Dstbrslcd },
        success: function (result) {
            $.each(result, function (index, ListRetailer) {
                $('#RetailerCode').append('<option value="' + ListRetailer.value + '">' + ListRetailer.text + '</option>');
            });
            $('#RetailerCode').trigger('change'); // Refresh Select2
            $("#WaitingMode").hide();
        },
        error: function (XMLHttpRequest, textStatus, errorThrown) {
            $("#WaitingMode").hide();
            msgError(XMLHttpRequest.responseText);
            $("body span h1").remove(); $("#msgbody_error style").remove();
        }
    });
    }
    function BindGroup() {
        
        $('#GroupCode').empty().append('<option value="">Select Group</option>');
            $.ajax({
                url: "@Url.Action("BindGroupData", PageControllerName)",
                type: 'POST',
                beforesend: $("#WaitingMode").show(),
                data: $('form').serialize(),
                success: function (result) {
                    $.each(result, function (index, ListGroup) {
                        $('#GroupCode').append('<option value="' + ListGroup.value + '">' + ListGroup.text + '</option>');
                    });
                    $('#GroupCode').trigger('change.select2'); // Refresh Select2
                    $("#WaitingMode").hide();
                },
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                    $("#WaitingMode").hide();
                    msgError(XMLHttpRequest.responseText);
                    $("body span h1").remove(); $("#msgbody_error style").remove();
                }
            });
    }
    function BindCollection() {
        
        $('#CollCode').empty().append('<option value="">Select Collection</option>');
        $.ajax({
            url: "@Url.Action("BindCollectionData", PageControllerName)",
            type: 'POST',
        beforesend: $("#WaitingMode").show(),
        data: $('form').serialize(),
        success: function (result) {
            $.each(result, function (index, ListCollection) {
                $('#CollCode').append('<option value="' + ListCollection.value + '">' + ListCollection.text + '</option>');
            });
            $('#CollCode').trigger('change.select2'); // Refresh Select2
            $("#WaitingMode").hide();
        },
        error: function (XMLHttpRequest, textStatus, errorThrown) {
            $("#WaitingMode").hide();
            msgError(XMLHttpRequest.responseText);
            $("body span h1").remove(); $("#msgbody_error style").remove();
        }
    });
    }
</script>
<script>
    function GetItemData() {

        if (!emptyFieldCheck("Please Select Distributor Name", "Dstbrslcd")) { return false; }
        if (!emptyFieldCheck("Please Select Retailer Name", "RetailerCode")) { return false; }
        if (!emptyFieldCheck("Please Select Brand", "BrandCode")) { return false; }
        $.ajax({
            type: 'post',
            beforesend: $("#WaitingMode").show(),
            url: "@Url.Action("GetItem", PageControllerName)",
            data: $('form').serialize() + "&DOCNO=" + $("#DOCNO").val() + "&DOC_CD=" + $("#DOC_ID").val(),
            success: function (result) {

               
                $("#partialdivDetail").html(result);
                $("#CartDiv").show();
                $("#FilterDiv").hide();
                $("#DISTSLNM").html($("#Dstbrslnm").val().split(String.fromCharCode(181))[0]);
                $("#RTSLNM").html($("#RetailerName").val().split(String.fromCharCode(181))[0]);
                if ($("#BrandName").val() != "") {
                    $("#BRANDNM").html("[" + $("#BrandName").val() + "]");
                }
                if ($("#GroupName").val() != "") {
                    $("#GRPNM").html("[" + $("#GroupName").val() + "]");
                }
                if ($("#CollName").val() != "") {
                    $("#COLLNM").html("[" + $("#CollName").val() + "]");
                }
                $("#SLCD").val($("#Dstbrslcd").val());
                $("#RTLCD").val($("#RetailerCode").val());
                $("#WaitingMode").hide();
            },
            error: function (XMLHttpRequest, textStatus, errorThrown) {
                $("#WaitingMode").hide();
                msgError(XMLHttpRequest.responseText);
                $("body span h1").remove(); $("#msgbody_error style").remove();
            }
        });
    }    
    function RetailMaster() {

        if (!emptyFieldCheck("Please Select Distributor Name", "Dstbrslcd")) { return false; }
        $.ajax({
            type: 'post',
            beforesend: $("#WaitingMode").show(),
            url: "@Url.Action("OpenRetailMaster", PageControllerName)",
            data: $('form').serialize() ,
        success: function (result) {
            sessionStorage.setItem("reloadOnBack", "true");
            let op = "A";
            let mnudet = encodeURIComponent("UFJPRE1BU1R+MH5NX0dycE1hc3R+fk1+MH4wfkFFRFY=");
            let us = '@Model.UNQSNO_ENCRYPTED';
            let dc = "";
            let mp = "";
            window.location.href = '@Url.Action("M_RetailOutlet", "M_RetailOutlet")'
    + `?op=${op}&MNUDET=${mnudet}&US=${us}&DC=${dc}&MP=${mp}`;

        $("#WaitingMode").hide();

        },
        error: function (XMLHttpRequest, textStatus, errorThrown) {
            $("#WaitingMode").hide();
            msgError(XMLHttpRequest.responseText);
            $("body span h1").remove(); $("#msgbody_error style").remove();
        }
    });
    }

    function EditeRetailMaster() {
        if (!emptyFieldCheck("Please Select Distributor Name", "Dstbrslcd")) { return false; }
        if (!emptyFieldCheck("Please Select Retailer Name To Modify", "RetailerCode")) { return false; }

        $.ajax({
            type: 'post',
            beforesend: $("#WaitingMode").show(),
            url: "@Url.Action("OpenRetailMaster", PageControllerName)",
            data: $('form').serialize() ,
        success: function (result) {
            sessionStorage.setItem("reloadOnBack", "true");
            let op = "E";
            let mnudet = encodeURIComponent("UFJPRE1BU1R+MH5NX0dycE1hc3R+fk1+MH4wfkFFRFY=");
            let us = '@Model.UNQSNO_ENCRYPTED';
            let dc = "";
            let mp = "";
            let rtslcd = $("#RetailerCode").val();;

            window.location.href = '@Url.Action("M_RetailOutlet", "M_RetailOutlet")'
    + `?op=${op}&MNUDET=${mnudet}&US=${us}&DC=${dc}&MP=${mp}&searchValue=${rtslcd}`;
            
        $("#WaitingMode").hide();

        },
        error: function (XMLHttpRequest, textStatus, errorThrown) {
            $("#WaitingMode").hide();
            msgError(XMLHttpRequest.responseText);
            $("body span h1").remove(); $("#msgbody_error style").remove();
        }
    });
    }
</script>
<script>
    function ChkMailNumber() {
        var RetailerCode = $("#RetailerCode").val();
        if (RetailerCode) {
            $("#BtnModiRtl").prop("disabled", false);
        }
        else {
            $("#BtnModiRtl").prop("disabled", true);
        }

        var selectedText = $('#RetailerCode option:selected').text();
        if (!selectedText || selectedText === "Select Retailer") {
            return;
        }
        var parts = selectedText.split(String.fromCharCode(181));

        
        var email = parts[2] || "";
        var mobile = parts[3] || "";

        // Validation
        if (mobile === "" && email === "") {
            showCustomAlert('warning', 'Retailer has no Whatsapp/Mobile Number and Email.');
        }
        else if (mobile === "") {
            showCustomAlert('warning', 'Retailer has no Whatsapp/Mobile Number.');
        }
        else if (email === "") {
            showCustomAlert('warning', 'Retailer has no Email.');
        }
    }
</script>
<script>
    function OpenFilter(){
        $("#FilterDiv").show();
        $("#CartDiv").hide();
    }
</script>
<script>
function toggleExpand(el) {
    if(el.style.whiteSpace === 'nowrap') {
        el.style.whiteSpace = 'normal';
        el.style.overflow = 'visible';
        const container = document.getElementById('header-text');
        if (container) {
            container.style.overflowY = 'auto';
        }
    } else {
        el.style.whiteSpace = 'nowrap';
        el.style.overflow = 'hidden';
    }
}
</script>
@using (Html.BeginForm())
