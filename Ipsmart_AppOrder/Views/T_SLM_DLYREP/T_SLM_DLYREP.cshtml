@model Improvar.ViewModels.VM_SLMDLYREP
@{
    Layout = "~/Views/Shared/_LayoutTransaction.cshtml";
    string PageControllerName = "T_SLM_DLYREP";
    string US = Model?.UNQSNO_ENCRYPTED;

}
<link href="~/Content/swiper-bundle.min.css" rel="stylesheet" />
<script src="~/Scripts/swiper-bundle.min.js"></script>
<script src="~/Scripts/sweetalert2@11.js"></script>
<style>

/* ===== GLOBAL TABLE ===== */
table {
    width: 100%;
    border-collapse: collapse;
}

/* readonly input background */
.inner-table td:has(input[readonly]) {
    background: #eeeeee;
}

/* scroll container */
.table-responsive {
    overflow-x: auto;
    overflow-y: auto;
}

.sub-top {
    position: fixed;
    left: 0;
    width: 100%;
}

/* ===== INNER GRID LAYOUT ===== */

.inner-table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
}

.inner-table td {
    text-align: center;
    padding: 6px 4px;
    border: 1px solid #cfd8dc;
    font-size: 12px;
}

/* header */
.m-header td {
    background: #1f4e79;
    color: #fff;
    font-weight: 600;
}

/* sticky header */
.header-table td {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: #1f4e79;
}

/* scroll body */
.table-scroll {
    max-height: 63vh;
    overflow-y: auto;
}

.table-header-fixed {
    position: sticky;
    top: 0;
    z-index: 1000;
}

/* ===== SL COLUMN ===== */

.menu {
    display: flex;
    align-items: center;
}

.sl-badge {
    background: #1f4e79;
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 12px;
}

/* ===== INPUTS / DROPDOWN ===== */

.inner-table select,
.inner-table input {
    width: 100%;
    box-sizing: border-box;
    font-size: 12px;
}

/* remove bootstrap default look inside grid */
#tblMain td input.form-control {
    border: none;
    background: transparent;
    margin: 0;
    outline: none;
    box-shadow: none;
}

/* wrapping text */
#tblMain th,
#tblMain td {
    white-space: normal;
    word-break: break-word;
    overflow-wrap: break-word;
    padding: 0;
    border: 1px solid #ddd;
}

/* ===== MOBILE OPTIMIZATION ===== */

@@media (max-width: 768px) {

    .item-card td {
        position: relative;
        padding: 12px 8px;
        border: none;
    }
}

/* WRAP TEXT (important) */
.select2-results__option {
    white-space: normal !important;
    word-break: break-word;
    overflow-wrap: break-word;
    line-height: 1.3;
    padding: 8px 10px;
}
.card-wrap{
    background:#fff;
    border-radius:14px;
    box-shadow:0 4px 14px rgba(0,0,0,0.08);
    overflow:hidden;
    margin-bottom:10px;
}
</style>

<script>
    window.addEventListener("unload", function () { });

    // If this page loads and reloadOnBack flag is set, refresh
    if (sessionStorage.getItem("reloadOnBack") === "true") {
        sessionStorage.removeItem("reloadOnBack");
        location.reload();
    }
</script>
<script type="text/javascript">
    $(document).ready(function () {
        //getLocation();

        $('#REPAUTONO').select2({
            width: '100%',
            placeholder: "Select Record",
            allowClear: true,
        });
        $("#show_dtl").hide();
    });
    
</script>
<script>
    $(function () {
            $("#DOCDT").datepicker({ dateFormat: "dd/mm/yy", changeMonth: false, changeYear: false, maxDate: '@Model.maxdate', minDate: '@Model.mindate' });
    });
</script>
<script>
    function requiredFieldValidator() {        
        if (!emptyFieldCheck("Enter / Select Document Date", "DOCDT")) { return false; }        
        return true;
    }
</script>

<script>
    function DeleteRowData(index) {
        var SLNO = $("#SLNO_" + index).val();

        $.ajax({
            type: 'POST',
            beforesend: $("#WaitingMode").show(),
            url: "@Url.Action("DeleteRow", PageControllerName)",
            data: $('form').serialize() + "&SerialNo=" + SLNO,
            success: function (result) {
                $("#partialdivMain").html(result);
                $("#WaitingMode").hide();
            },
            error: function (XMLHttpRequest, textStatus, errorThrown) {
                $("#WaitingMode").hide();
                msgError(XMLHttpRequest.responseText);
                $("body span h1").remove(); $("#msgbody_error style").remove();
            }
        });

    }
    function AddRowData() {
        $.ajax({
            type: 'POST',
            beforesend: $("#WaitingMode").show(),
            url: "@Url.Action("AddRow", PageControllerName)",
            data: $('form').serialize(),
            success: function (result) {
                $("#partialdivMain").html(result);
                $("#WaitingMode").hide();
            },
            error: function (XMLHttpRequest, textStatus, errorThrown) {
                $("#WaitingMode").hide();
                msgError(XMLHttpRequest.responseText);
                $("body span h1").remove(); $("#msgbody_error style").remove();
            }
        });

    }
</script>
<script>
    function FillGridData() {

        if (!emptyFieldCheck("Select Salesmem Record", "REPAUTONO")) { return false; }
        var REPAUTONO = $("#REPAUTONO").val();
        $.ajax({
            type: 'post',
            beforesend: $("#WaitingMode").show(),
            url: "@Url.Action("FillGrid", PageControllerName)",
            data: $('form').serialize() + "&REPAUTONO=" + REPAUTONO,
            success: function (result) {
                debugger;
                var res = result.split("^^^^^^^^^^^^~~~~~~^^^^^^^^^^");
                $("#partialdivMain").html(res[2]);
                $("#DOCDT").val(res[0]);
                $("#DOCREM").val(res[1]);
                $("#WaitingMode").hide();
            },
            error: function (XMLHttpRequest, textStatus, errorThrown) {
                $("#WaitingMode").hide();
                msgError(XMLHttpRequest.responseText);
                $("body span h1").remove(); $("#msgbody_error style").remove();
            }
        });

    }
</script>
<script>    
    function DeptDivtoggle() {
        $("#hide_dlt").hide();
        $("#hide_dlt_1").hide();
        $("#show_dtl").show();
    }

</script>
@using (Html.BeginForm())
{
    if (Model.DefaultView == true)
    {
        @Html.HiddenFor(a => Model.maxdate)
        @Html.HiddenFor(a => Model.mindate)
        <div class="form-horizontal" style="padding-left:5px;padding-right:5px;">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <input type="hidden" id="btnSave" value="@Url.Action("SAVE", PageControllerName)" />
            <input type="hidden" id="MetalCode" value="@Url.Action("CheckCode", PageControllerName)" />
            <input type="hidden" id="srhpnl" value="@Url.Action("SearchPannelData", PageControllerName)" />
            <input type="hidden" id="add_doc_url" value="@Url.Action("AddDOCRow", PageControllerName )" />
            <input type="hidden" id="del_doc_url" value="@Url.Action("DeleteDOCRow", PageControllerName )" />
            @Html.HiddenFor(model => model.GEOLONGITUDE)
            @Html.HiddenFor(model => model.GEOLATITUDE)
            @Html.HiddenFor(s => s.DefaultAction)
            @Html.HiddenFor(s => s.UNQSNO)
            @Html.HiddenFor(a => a.T_SLM_DLYREP_HDR.AUTONO, new { id = "AUTONO" })
            @Html.HiddenFor(a => a.T_CNTRL_HDR.MNTHCD, new { id = "MNTHCD" })
            @Html.HiddenFor(a => a.T_CNTRL_HDR.DOCNO, new { id = "DOCNO" })
            @Html.HiddenFor(a => a.MENU_PARA, new { id = "MENU_PARA" })
            @Html.HiddenFor(a => a.T_CNTRL_HDR.DOCONLYNO, new { id = "DOCONLYNO" })
            @Html.HiddenFor(a => a.T_CNTRL_HDR.DOCCD, new { id = "DOCCD" })

            <div id="FilterDiv">
                <div class="row" id="divGetRetailerInfo">
                    <div class="col-lg-1">
                        <div class="editor-field" style="margin-top: 4px;">
                            @Html.Label("", "Document Date")
                            <b style="color:Red;">*</b>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="editor-field">
                            @Html.EditorFor(model => model.T_SLM_DLYREP_HDR.DOCDT, new { htmlAttributes = new { @class = "form-control", id = "DOCDT", maxlength = 10, @placeholder = "dd/mm/yyyy" } })
                        </div>
                    </div>
                </div>

                <div class="row" id="divGetRetailerInfo">
                    <div class="col-lg-1">
                        <div class="editor-field" style="margin-top: 4px;">
                            @Html.Label("", "Remarks")
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="editor-field" style="margin-top: 4px;">
                            @Html.TextBoxFor(model => model.T_SLM_DLYREP_HDR.DOCREM, new { @class = "form-control", id = "DOCREM", maxlength = 500, placeholder = "Remarks", type = "text" })
                        </div>
                    </div>
                    <div class="col-md-6" id="btn_" style="width:auto;margin-top: 4px;">
                        <div class="editor-field">                            
                            <input type="button" class="btn btn-info" style="padding:2px 2px 2px 2px;" value="Edite Record" onclick="DeptDivtoggle()" />
                        </div>
                    </div>
                </div>
                <div class="row" id="show_dtl">
                    <div class="col-lg-1">
                        <div class="editor-field" style="margin-top: 4px;">
                            @Html.Label("", "Salesman Record")
                            <b style="color:Red;">*</b>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="editor-field" style="margin-top: 4px;">
                            @Html.DropDownListFor(model => model.REPAUTONO, new SelectList(Model.DropDown_list_REPAUTONO, "Value", "Text", Model.REPAUTONO), "Select", new { @class = "form-control select2", id = "REPAUTONO" })
                        </div>
                    </div>
                    <div class="col-md-6" style="width:auto;margin-top: 4px;">
                        <div class="editor-field">
                            <input type="button" class="btn btn-info" style="padding:2px 2px 2px 2px;" value="Fill Data" onclick="FillGridData()" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="table-responsive row sub-top" id="partialdivMain" style="max-height:68%; overflow-y:auto;margin-top:10px;">
                @Html.Partial("_T_SLM_DLYREP")
            </div>
            @*<div class="footer" style="padding:5px;">
                <div class="quantity-row">
                    <button type="button" style="margin-top: 2px;margin-left: 2px;padding: 2px 7px 1px 7px;" class="btn btn-sm btn-success" onclick="SaveData()" title="Add to Cart">Save <i class="fa fa-check-circle"></i></button>
                </div>
            </div>*@
        </div>
    }
    else
    {
        @ViewBag.ErrorMessage
    }

    <div class="container">
        <div id="helpDIV">

        </div>
    </div>
}

